<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spoton.cloudcli-scrub</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__REPO__/scripts/macos/transcript-scrub.mjs</string>
    </array>

    <!-- Hourly, plus once at load so a fresh install scrubs immediately. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/forge-logs/cloudcli-scrub/job.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/forge-logs/cloudcli-scrub/job.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
