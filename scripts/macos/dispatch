#!/bin/zsh
# dispatch — the fire-once chain runner (spec B4).
#
#   dispatch <project> <slug> [phase-file ...]
#   dispatch pause <project> <slug>
#   dispatch resume <project> <slug>
#   dispatch fast <project> <slug> on|off
#   dispatch append <project> <slug> <file ...> [--phase]
#   dispatch amend <project> <slug> <unit> --tasks "a | b | c" [--name N] [--anchor A]
#
# <project> is a folder name under ~/Projects or an absolute repo path.
# Phase prompt files: explicit paths, or by convention every file matching
# <repo>/.dispatch/<slug>/*.md in lexical order. A phase manifest the planner
# wrote at <repo>/.dispatch/<slug>/manifest.json (or DISPATCH_MANIFEST) rides
# along: a JSON array of {name, tasks[], anchor?} in phase order, or
# {punchlist, entries: [...]} where punchlist is the run's punch list file
# (repo-relative or absolute) and each entry's anchor names its punch list
# heading so the navigator can count checked-off tasks per phase; the
# watchdog stores it and the worker pane's phase navigator renders it.
# Validation happens here;
# execution is handed to dispatch-chain-runner, spawned fully detached (own
# session) so a Command Center server restart or promote mid-chain never touches a
# running chain. Each phase runs as a fresh headless `claude -p` session with
# the commit gate between phases; progress journals to ~/forge-logs/<slug>/
# and the runner reports boundaries to the watchdog, which wakes the
# project's planner at the end. The planner invokes this once and goes idle;
# it never polls.
#
# Every unit is two stages since ui14 job 10: the build (the phase prompt,
# ending at its commit) and a verify (a second fresh-context session that
# checks the commit against the unit's done check and answers `VERIFY: PASS`
# or `VERIFY: FAIL: <reason>` on its last line). The verify runs while the
# next unit builds; a phase file carrying `<!-- verify: no -->` skips its
# verify stage. A failed verify stops the chain, parks the interrupted
# build's work on a branch, and wakes the planner with the resume point.
#
# `dispatch append` queues additional prompt files onto an active chain; the
# runner picks them up after the current phase's commit gate. Appended units
# are "tasks" (lighter navigator rows) unless --phase marks a full compiled
# unit.
#
# Per-unit engine (codex job 2): any prompt file, dispatched or appended, may
# carry `<!-- engine: claude|codex -->`, `<!-- model: <id> -->` and
# `<!-- effort: <level> -->` in its header; the runner applies them to that
# unit only, over the chain's DISPATCH_ENGINE / DISPATCH_MODEL /
# DISPATCH_EFFORT. An engine header naming anything else is refused here.
#
# `dispatch amend` rewrites a not-yet-started unit's stored task list (ui14
# job 8) so a fold-in the planner made to the prompt file and punch list also
# reaches the jobs view; the executing or finished unit is refused.
set -u

SCRIPT_DIR="${0:A:h}"
NODE=$(command -v node || echo /usr/local/bin/node)
eval "$("$NODE" "$SCRIPT_DIR/../../shared/runtime-anchors.js" --shell)"

PROJECTS_ROOT="$HOME/Projects"
SERVER_URL="${DISPATCH_SERVER_URL:-http://127.0.0.1:4747}"
DB_PATH="${DISPATCH_DB_PATH:-$COMMAND_CENTER_RUNTIME_DATA_DIR/auth.db}"

# Refuses a prompt file whose engine header names an engine the runner lacks.
check_engine_header() {
  local engine
  engine=$(python3 - "$1" <<'PYEOF'
import re, sys
head = open(sys.argv[1], encoding='utf-8', errors='replace').read(4096)
m = re.search(r'<!--\s*engine:\s*(.*?)\s*-->', head, re.I)
print((m.group(1) if m else '').lower())
PYEOF
)
  [[ -z "$engine" || "$engine" == "claude" || "$engine" == "codex" ]] \
    || { print -u2 "dispatch: $1 names engine '$engine'; must be claude or codex"; exit 65; }
}

usage() {
  print -u2 "usage: dispatch <project> <slug> [phase-file ...]"
  print -u2 "       dispatch pause <project> <slug>"
  print -u2 "       dispatch resume <project> <slug>"
  print -u2 "       dispatch fast <project> <slug> on|off"
  print -u2 "       dispatch append <project> <slug> <file ...> [--phase]"
  print -u2 "       dispatch amend <project> <slug> <unit> --tasks \"a | b | c\" [--name N] [--anchor A]"
  exit 64
}
[[ $# -ge 2 ]] || usage

# ----- fast: change the next Codex build unit without restarting the chain -----
if [[ "$1" == "fast" ]]; then
  shift
  [[ $# -eq 3 ]] || usage
  PROJECT_ARG="$1"; SLUG="$2"; FAST_VALUE="$3"
  [[ "$FAST_VALUE" == "on" || "$FAST_VALUE" == "off" ]] || usage
  if [[ "$PROJECT_ARG" == /* ]]; then
    REPO="$PROJECT_ARG"
  else
    REPO="$PROJECTS_ROOT/$PROJECT_ARG"
  fi
  [[ -d "$REPO/.git" ]] || { print -u2 "dispatch: $REPO is not a git repo"; exit 66; }
  REPO="${REPO:A}"

  API_KEY=$(/usr/bin/sqlite3 "$DB_PATH" "SELECT api_key FROM api_keys WHERE is_active=1 ORDER BY id LIMIT 1" 2>/dev/null)
  [[ -n "$API_KEY" ]] || { print -u2 "dispatch: no active API key in server config"; exit 78; }
  HEADER_FILE=$(mktemp)
  chmod 600 "$HEADER_FILE"
  print -r -- "header = \"x-api-key: $API_KEY\"" > "$HEADER_FILE"
  trap 'rm -f "$HEADER_FILE"' EXIT
  BODY=$(python3 - "$REPO" "$FAST_VALUE" <<'PYEOF'
import json, sys
print(json.dumps({'projectPath': sys.argv[1], 'fastMode': sys.argv[2] == 'on'}))
PYEOF
)
  RESPONSE=$(curl -s -K "$HEADER_FILE" -m 30 -X PATCH "$SERVER_URL/api/watchdog/chains/$SLUG/fast" \
    -H 'Content-Type: application/json' -d "$BODY" -w '\n%{http_code}' 2>/dev/null)
  STATUS="${RESPONSE##*$'\n'}"
  RESPONSE_BODY="${RESPONSE%$'\n'*}"
  if [[ "$STATUS" != "200" ]]; then
    print -u2 "dispatch: could not turn fast mode $FAST_VALUE for chain $SLUG (HTTP ${STATUS:-000}: $RESPONSE_BODY)"
    exit 69
  fi
  print -r -- "dispatch: chain $SLUG fast mode $FAST_VALUE; the next Codex job reads the new setting"
  exit 0
fi

# ----- pause/resume: control one existing chain record -----
if [[ "$1" == "pause" || "$1" == "resume" ]]; then
  ACTION="$1"; shift
  [[ $# -eq 2 ]] || usage
  PROJECT_ARG="$1"; SLUG="$2"
  if [[ "$PROJECT_ARG" == /* ]]; then
    REPO="$PROJECT_ARG"
  else
    REPO="$PROJECTS_ROOT/$PROJECT_ARG"
  fi
  [[ -d "$REPO/.git" ]] || { print -u2 "dispatch: $REPO is not a git repo"; exit 66; }
  REPO="${REPO:A}"

  API_KEY=$(/usr/bin/sqlite3 "$DB_PATH" "SELECT api_key FROM api_keys WHERE is_active=1 ORDER BY id LIMIT 1" 2>/dev/null)
  [[ -n "$API_KEY" ]] || { print -u2 "dispatch: no active API key in server config"; exit 78; }
  HEADER_FILE=$(mktemp)
  chmod 600 "$HEADER_FILE"
  print -r -- "header = \"x-api-key: $API_KEY\"" > "$HEADER_FILE"
  trap 'rm -f "$HEADER_FILE"' EXIT
  BODY=$(python3 - "$REPO" <<'PYEOF'
import json, sys
print(json.dumps({'projectPath': sys.argv[1]}))
PYEOF
)

  if [[ "$ACTION" == "resume" ]]; then
    RUNNER="${0:A:h}/dispatch-chain-runner"
    [[ -x "$RUNNER" ]] || { print -u2 "dispatch: runner missing at $RUNNER"; exit 70; }
    RESUME_STATE="$HOME/forge-logs/$SLUG/resume.json"
    [[ -r "$RESUME_STATE" ]] || { print -u2 "dispatch: chain $SLUG has no saved runner state to resume"; exit 66; }
    python3 - "$RESUME_STATE" "$REPO" "$SLUG" <<'PYEOF'
import json, os, sys
state = json.load(open(sys.argv[1], encoding='utf-8'))
if os.path.realpath(state.get('repo', '')) != os.path.realpath(sys.argv[2]) or state.get('slug') != sys.argv[3]:
    raise SystemExit('dispatch: saved runner state does not match this project and slug')
files = state.get('phaseFiles')
if not isinstance(files, list) or not files or any(not os.path.isfile(path) for path in files):
    raise SystemExit('dispatch: saved runner state names a missing phase file')
PYEOF
    [[ $? -eq 0 ]] || exit 66
    [[ -z "$(git -C "$REPO" status --porcelain)" ]] \
      || { print -u2 "dispatch: $REPO has uncommitted work; cannot restore paused work onto it"; exit 69; }
  fi

  REQUEST_TIMEOUT_S=60
  # A pause is allowed to wait for the current verifier's full unattended
  # budget. The watchdog uses 30 minutes; the CLI leaves a small response
  # margin so it never gives up first and strands a pause that later lands.
  [[ "$ACTION" == "pause" ]] && REQUEST_TIMEOUT_S="${DISPATCH_PAUSE_TIMEOUT_S:-1830}"
  RESPONSE=$(curl -s -K "$HEADER_FILE" -m "$REQUEST_TIMEOUT_S" -X POST "$SERVER_URL/api/watchdog/chains/$SLUG/$ACTION" \
    -H 'Content-Type: application/json' -d "$BODY" -w '\n%{http_code}' 2>/dev/null)
  STATUS="${RESPONSE##*$'\n'}"
  RESPONSE_BODY="${RESPONSE%$'\n'*}"
  if [[ "$STATUS" == "409" ]]; then
    print -r -- "dispatch: chain $SLUG is not $([[ "$ACTION" == pause ]] && print running || print paused); nothing changed"
    exit 0
  fi
  if [[ "$STATUS" != "200" ]]; then
    print -u2 "dispatch: could not $ACTION chain $SLUG (HTTP ${STATUS:-000}: $RESPONSE_BODY)"
    exit 69
  fi

  if [[ "$ACTION" == "pause" ]]; then
    print -r -- "dispatch: chain $SLUG paused; its runner and active build have exited and any verifier recorded its verdict"
    exit 0
  fi

  RESUME_PHASE=$(RESPONSE_BODY="$RESPONSE_BODY" python3 -c 'import json,os; print(json.loads(os.environ["RESPONSE_BODY"])["data"]["phase"])')
  JOURNAL_DIR="$HOME/forge-logs/$SLUG"
  RUNNER_PID=$(python3 - "$RUNNER" "$RESUME_STATE" "$RESUME_PHASE" "$JOURNAL_DIR/runner.log" <<'PYEOF'
import json, os, subprocess, sys
runner, state_path, phase, log = sys.argv[1:5]
state = json.load(open(state_path, encoding='utf-8'))
env = os.environ.copy()
env.update({
    'DISPATCH_ENGINE': state['engine'],
    'DISPATCH_MODEL': state['model'],
    'DISPATCH_EFFORT': state['effort'],
    'DISPATCH_VERIFY_ENGINE': state['verifyEngine'],
    'DISPATCH_VERIFY_MODEL': state['verifyModel'],
    'DISPATCH_RESUME_FROM': phase,
    'DISPATCH_RESUMING': '1',
    'DISPATCHING_SESSION_ID': state.get('dispatchingSessionId', ''),
})
with open(log, 'ab') as out:
    proc = subprocess.Popen(
        [runner, state['repo'], state['slug'], *state['phaseFiles']],
        stdin=subprocess.DEVNULL, stdout=out, stderr=out,
        start_new_session=True, cwd='/', env=env,
    )
print(proc.pid)
PYEOF
)
  print -r -- "dispatch: chain $SLUG resumed at job $RESUME_PHASE (runner pid $RUNNER_PID); the watchdog wakes the planner only at the true end"
  exit 0
fi

# ----- amend: replace a queued unit's task list on an active chain -----
if [[ "$1" == "amend" ]]; then
  shift
  [[ $# -ge 4 ]] || usage
  PROJECT_ARG="$1"; SLUG="$2"; UNIT="$3"; shift 3
  [[ "$UNIT" == <1-> ]] || { print -u2 "dispatch: unit must be a 1-based index"; exit 64; }

  AMEND_TASKS=""; AMEND_NAME=""; AMEND_ANCHOR=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tasks) AMEND_TASKS="${2:-}"; shift 2 2>/dev/null || usage ;;
      --name) AMEND_NAME="${2:-}"; shift 2 2>/dev/null || usage ;;
      --anchor) AMEND_ANCHOR="${2:-}"; shift 2 2>/dev/null || usage ;;
      *) usage ;;
    esac
  done
  [[ -n "$AMEND_TASKS$AMEND_NAME$AMEND_ANCHOR" ]] || usage

  API_KEY=$(/usr/bin/sqlite3 "$DB_PATH" "SELECT api_key FROM api_keys WHERE is_active=1 ORDER BY id LIMIT 1" 2>/dev/null)
  [[ -n "$API_KEY" ]] || { print -u2 "dispatch: no active API key in server config"; exit 78; }
  HEADER_FILE=$(mktemp)
  chmod 600 "$HEADER_FILE"
  print -r -- "header = \"x-api-key: $API_KEY\"" > "$HEADER_FILE"
  trap 'rm -f "$HEADER_FILE"' EXIT

  BODY=$(AMEND_TASKS="$AMEND_TASKS" AMEND_NAME="$AMEND_NAME" AMEND_ANCHOR="$AMEND_ANCHOR" python3 - <<'PYEOF'
import json, os
body = {}
tasks = [t.strip() for t in os.environ['AMEND_TASKS'].split('|') if t.strip()]
if tasks:
    body['tasks'] = tasks
if os.environ['AMEND_NAME']:
    body['name'] = os.environ['AMEND_NAME']
if os.environ['AMEND_ANCHOR']:
    body['anchor'] = os.environ['AMEND_ANCHOR']
print(json.dumps(body))
PYEOF
)
  RESPONSE=$(curl -s -K "$HEADER_FILE" -m 30 -X POST "$SERVER_URL/api/watchdog/chains/$SLUG/phases/$UNIT/tasks" \
      -H 'Content-Type: application/json' -d "$BODY" -w '\n%{http_code}' 2>/dev/null)
  STATUS="${RESPONSE##*$'\n'}"
  if [[ "$STATUS" != "200" ]]; then
    print -u2 "dispatch: chain $SLUG refused the amend of unit $UNIT (HTTP ${STATUS:-000}: ${RESPONSE%$'\n'*})"
    exit 69
  fi
  print -r -- "dispatch: unit $UNIT of chain $SLUG amended; the jobs view shows it now and the runner reads the prompt file at job start"
  exit 0
fi

# ----- append: queue additional work onto an active chain -----
if [[ "$1" == "append" ]]; then
  shift
  [[ $# -ge 3 ]] || usage
  PROJECT_ARG="$1"; SLUG="$2"; shift 2

  # One row style for every unit (ui17 job 11): appends are phases like any
  # other unit. `--phase` stays accepted as a no-op so old call sites keep
  # working.
  KIND="phase"
  typeset -a APPEND_FILES
  APPEND_FILES=()
  for arg in "$@"; do
    if [[ "$arg" == "--phase" ]]; then
      :
    else
      APPEND_FILES+=("$arg")
    fi
  done
  [[ ${#APPEND_FILES[@]} -gt 0 ]] || usage
  for f in "${APPEND_FILES[@]}"; do
    [[ -r "$f" ]] || { print -u2 "dispatch: cannot read append file $f"; exit 66; }
    check_engine_header "$f"
  done

  API_KEY=$(/usr/bin/sqlite3 "$DB_PATH" "SELECT api_key FROM api_keys WHERE is_active=1 ORDER BY id LIMIT 1" 2>/dev/null)
  [[ -n "$API_KEY" ]] || { print -u2 "dispatch: no active API key in server config"; exit 78; }
  HEADER_FILE=$(mktemp)
  chmod 600 "$HEADER_FILE"
  print -r -- "header = \"x-api-key: $API_KEY\"" > "$HEADER_FILE"
  trap 'rm -f "$HEADER_FILE"' EXIT

  # Announce first: a dead or finished chain refuses the append, and nothing
  # gets queued for a runner that will never pick it up. Appended prompt files
  # carry display metadata in comment headers at the top (ui11 phase 10):
  #   <!-- name: Worker pane live -->
  #   <!-- tasks: task one | task two | task three -->
  #   <!-- anchor: Phase 10 -->
  # so the navigator announces real task rows and punch-list counters for
  # appended units; the filename is the fallback when headers are absent.
  ENTRIES=$(python3 - "$KIND" "${APPEND_FILES[@]}" <<'PYEOF'
import json, os, re, sys
kind = sys.argv[1]
entries = []
for path in sys.argv[2:]:
    head = open(path, encoding='utf-8', errors='replace').read(4096)
    meta = dict(re.findall(r'<!--\s*(name|tasks|anchor):\s*(.*?)\s*-->', head))
    entry = {'name': meta.get('name') or os.path.splitext(os.path.basename(path))[0], 'kind': kind}
    entry['tasks'] = [t.strip() for t in meta.get('tasks', '').split('|') if t.strip()]
    if meta.get('anchor'):
        entry['anchor'] = meta['anchor']
    entries.append(entry)
print(json.dumps({'entries': entries}))
PYEOF
)
  if ! curl -sf -K "$HEADER_FILE" -m 30 -X POST "$SERVER_URL/api/watchdog/chains/$SLUG/append" \
      -H 'Content-Type: application/json' -d "$ENTRIES" >/dev/null 2>&1; then
    print -u2 "dispatch: chain $SLUG refused the append (not registered or not running)"
    exit 69
  fi

  APPEND_DIR="$HOME/forge-logs/$SLUG/append"
  mkdir -p "$APPEND_DIR"
  STAMP=$(date +%s)
  i=0
  # Queue names always end .md — the runner only picks up *.md.
  for f in "${APPEND_FILES[@]}"; do
    i=$((i + 1))
    cp "$f" "$APPEND_DIR/$STAMP-$i.$KIND.${f:t:r}.md"
  done
  print -r -- "dispatch: ${#APPEND_FILES[@]} $KIND(s) queued onto chain $SLUG; the runner picks them up after the current phase's commit gate"
  exit 0
fi

PROJECT_ARG="$1"; SLUG="$2"; shift 2

if [[ "$PROJECT_ARG" == /* ]]; then
  REPO="$PROJECT_ARG"
else
  REPO="$PROJECTS_ROOT/$PROJECT_ARG"
fi
[[ -d "$REPO/.git" ]] || { print -u2 "dispatch: $REPO is not a git repo"; exit 66; }
REPO="${REPO:A}"

# Capture the planner chat that owns this dispatch before detaching the runner.
# Provider runtimes expose their native id in one of these variables; resolve
# it to Command Center's app-facing id. With no usable context, the project's
# manual wake target wins, then the newest planner chat is the final fallback.
DISPATCH_CONTEXT_SESSION_ID="${CODEX_THREAD_ID:-${CLAUDE_CODE_SESSION_ID:-}}"
DISPATCHING_SESSION_ID=$(python3 - "$DB_PATH" "$REPO" "$DISPATCH_CONTEXT_SESSION_ID" <<'PYEOF'
import sqlite3, sys

db_path, project_path, context_id = sys.argv[1:4]
try:
    db = sqlite3.connect(db_path)
    columns = {row[1] for row in db.execute('PRAGMA table_info(sessions)')}
    project_expr = 'COALESCE(assigned_project_path, project_path)' if 'assigned_project_path' in columns else 'project_path'
    if context_id:
        row = db.execute(
            f'''SELECT session_id FROM sessions
                WHERE {project_expr} = ? AND (session_id = ? OR provider_session_id = ?)
                LIMIT 1''',
            (project_path, context_id, context_id),
        ).fetchone()
        if row:
            print(row[0])
            raise SystemExit(0)
    if 'watchdog_wake_target' in columns:
        row = db.execute(
            f'''SELECT session_id FROM sessions
                WHERE {project_expr} = ? AND watchdog_wake_target = 1 AND isArchived = 0
                ORDER BY session_id DESC LIMIT 1''',
            (project_path,),
        ).fetchone()
        if row:
            print(row[0])
            raise SystemExit(0)
    row = db.execute(
        f'''SELECT session_id FROM sessions
            WHERE {project_expr} = ? AND origin = 'planner' AND isArchived = 0
            ORDER BY datetime(COALESCE(updated_at, created_at)) DESC, session_id DESC LIMIT 1''',
        (project_path,),
    ).fetchone()
    if not row:
        row = db.execute(
            f'''SELECT session_id FROM sessions
                WHERE {project_expr} = ? AND origin IS NULL AND isArchived = 0
                ORDER BY datetime(COALESCE(updated_at, created_at)) DESC, session_id DESC LIMIT 1''',
            (project_path,),
        ).fetchone()
    if row:
        print(row[0])
except (OSError, sqlite3.Error):
    pass
PYEOF
)
export DISPATCHING_SESSION_ID

# Phase files: explicit args, else the .dispatch/<slug>/ convention.
typeset -a PHASE_FILES
if [[ $# -gt 0 ]]; then
  PHASE_FILES=("$@")
else
  PHASE_FILES=("$REPO/.dispatch/$SLUG"/*.md(N))
fi
[[ ${#PHASE_FILES[@]} -gt 0 ]] || { print -u2 "dispatch: no phase prompt files for $SLUG"; exit 66; }
typeset -a ABS_PHASE_FILES
ABS_PHASE_FILES=()
for f in "${PHASE_FILES[@]}"; do
  [[ -r "$f" ]] || { print -u2 "dispatch: cannot read phase file $f"; exit 66; }
  check_engine_header "$f"
  ABS_PHASE_FILES+=("${f:A}")
done

# Phase manifest (ui9 B4): explicit DISPATCH_MANIFEST, else the convention
# path. Optional; when present it must parse as JSON before anything launches.
MANIFEST_PATH="${DISPATCH_MANIFEST:-$REPO/.dispatch/$SLUG/manifest.json}"
if [[ -r "$MANIFEST_PATH" ]]; then
  python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$MANIFEST_PATH" 2>/dev/null \
    || { print -u2 "dispatch: manifest $MANIFEST_PATH is not valid JSON"; exit 65; }
else
  MANIFEST_PATH=""
fi

# Fail fast while the planner is still listening; the runner re-reads the key
# itself (it may outlive several server restarts).
API_KEY=$(/usr/bin/sqlite3 "$DB_PATH" "SELECT api_key FROM api_keys WHERE is_active=1 ORDER BY id LIMIT 1" 2>/dev/null)
[[ -n "$API_KEY" ]] || { print -u2 "dispatch: no active API key in server config"; exit 78; }

RUNNER="${0:A:h}/dispatch-chain-runner"
[[ -x "$RUNNER" ]] || { print -u2 "dispatch: runner missing at $RUNNER"; exit 70; }

JOURNAL_DIR="$HOME/forge-logs/$SLUG"
mkdir -p "$JOURNAL_DIR"

# Detach via setsid (start_new_session): the runner leaves this process tree
# entirely, so neither the planner's session ending nor a server restart can
# reach it.
RUNNER_PID=$(DISPATCH_RUNNER_LOG="$JOURNAL_DIR/runner.log" \
  DISPATCH_MANIFEST="$MANIFEST_PATH" \
  python3 - "$RUNNER" "$REPO" "$SLUG" "${ABS_PHASE_FILES[@]}" <<'PYEOF'
import os, subprocess, sys
with open(os.environ['DISPATCH_RUNNER_LOG'], 'ab') as out:
    proc = subprocess.Popen(
        sys.argv[1:],
        stdin=subprocess.DEVNULL, stdout=out, stderr=out,
        start_new_session=True, cwd='/',
    )
print(proc.pid)
PYEOF
)
print -r -- "dispatch: chain $SLUG started (${#ABS_PHASE_FILES[@]} phases, runner pid $RUNNER_PID); the watchdog wakes the planner at the end"
