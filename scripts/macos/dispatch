#!/bin/zsh
# dispatch — the fire-once chain runner (spec B4).
#
#   dispatch <project> <slug> [phase-file ...]
#
# <project> is a folder name under ~/Projects or an absolute repo path.
# Phase prompt files: explicit paths, or by convention every file matching
# <repo>/.dispatch/<slug>/*.md in lexical order. Validation happens here;
# execution is handed to dispatch-chain-runner, spawned fully detached (own
# session) so a CloudCLI server restart or promote mid-chain never touches a
# running chain. Each phase runs as a fresh headless `claude -p` session with
# the commit gate between phases; progress journals to ~/forge-logs/<slug>/
# and the runner reports boundaries to the watchdog, which wakes the
# project's planner at the end. The planner invokes this once and goes idle;
# it never polls.
set -u

PROJECTS_ROOT="$HOME/Projects"
DB_PATH="$HOME/.cloudcli/auth.db"

usage() { print -u2 "usage: dispatch <project> <slug> [phase-file ...]"; exit 64; }
[[ $# -ge 2 ]] || usage

PROJECT_ARG="$1"; SLUG="$2"; shift 2

if [[ "$PROJECT_ARG" == /* ]]; then
  REPO="$PROJECT_ARG"
else
  REPO="$PROJECTS_ROOT/$PROJECT_ARG"
fi
[[ -d "$REPO/.git" ]] || { print -u2 "dispatch: $REPO is not a git repo"; exit 66; }

# Phase files: explicit args, else the .dispatch/<slug>/ convention.
typeset -a PHASE_FILES
if [[ $# -gt 0 ]]; then
  PHASE_FILES=("$@")
else
  PHASE_FILES=("$REPO/.dispatch/$SLUG"/*.md(N))
fi
[[ ${#PHASE_FILES[@]} -gt 0 ]] || { print -u2 "dispatch: no phase prompt files for $SLUG"; exit 66; }
typeset -a ABS_PHASE_FILES
ABS_PHASE_FILES=()
for f in "${PHASE_FILES[@]}"; do
  [[ -r "$f" ]] || { print -u2 "dispatch: cannot read phase file $f"; exit 66; }
  ABS_PHASE_FILES+=("${f:A}")
done

# Fail fast while the planner is still listening; the runner re-reads the key
# itself (it may outlive several server restarts).
API_KEY=$(/usr/bin/sqlite3 "$DB_PATH" "SELECT api_key FROM api_keys WHERE is_active=1 ORDER BY id LIMIT 1" 2>/dev/null)
[[ -n "$API_KEY" ]] || { print -u2 "dispatch: no active API key in server config"; exit 78; }

RUNNER="${0:A:h}/dispatch-chain-runner"
[[ -x "$RUNNER" ]] || { print -u2 "dispatch: runner missing at $RUNNER"; exit 70; }

JOURNAL_DIR="$HOME/forge-logs/$SLUG"
mkdir -p "$JOURNAL_DIR"

# Detach via setsid (start_new_session): the runner leaves this process tree
# entirely, so neither the planner's session ending nor a server restart can
# reach it.
RUNNER_PID=$(DISPATCH_RUNNER_LOG="$JOURNAL_DIR/runner.log" \
  python3 - "$RUNNER" "$REPO" "$SLUG" "${ABS_PHASE_FILES[@]}" <<'PYEOF'
import os, subprocess, sys
with open(os.environ['DISPATCH_RUNNER_LOG'], 'ab') as out:
    proc = subprocess.Popen(
        sys.argv[1:],
        stdin=subprocess.DEVNULL, stdout=out, stderr=out,
        start_new_session=True, cwd='/',
    )
print(proc.pid)
PYEOF
)
print -r -- "dispatch: chain $SLUG started (${#ABS_PHASE_FILES[@]} phases, runner pid $RUNNER_PID); the watchdog wakes the planner at the end"
