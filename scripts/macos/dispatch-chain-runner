#!/bin/zsh
# dispatch-chain-runner — the out-of-process chain executor behind `dispatch`.
#
#   dispatch-chain-runner <repo> <slug> <phase-file ...>
#
# Spawned fully detached (own session) by the dispatch CLI, so a Command Center
# server restart or promote mid-chain never touches a running chain. Each
# phase runs as a fresh headless session in the repo — `claude -p` or
# `codex exec`, per unit (codex job 2) — with the same commit gate, journal
# lines, and watchdog boundary events. Claude transcripts land in
# ~/.claude/projects, Codex rollouts in ~/.codex/sessions; both surface in
# the worker pane through the session synchronizers.
#
# Per-unit engine (codex job 2): a prompt file may carry `<!-- engine:
# claude|codex -->`, `<!-- model: <id> -->` and `<!-- effort: <level> -->`
# in its header; each overrides the chain's DISPATCH_ENGINE / DISPATCH_MODEL
# / DISPATCH_EFFORT for that unit only, and a missing header falls back to
# the env, then the engine default (Claude: claude-opus-5 at high with the
# claude-opus-4-8 capacity fallback; Codex: gpt-5.6-sol at high).
# DISPATCH_RUN_DATE is resolved by this runner at the chain's first start as
# YYYYMMDD. DISPATCH_RUN_SUMMARY_PATH is the fully resolved memory-repo path.
# Both are persisted across pause/reload and exported to every unit so its
# phase tail references the chain's real start date rather than compile time.
# Worker journal clause: one line per entry, YYYY-MM-DD HH:MM | phase or task
# | event | detail.
#
# Pipelined verification (ui14 job 10): every unit is two stages. The build
# stage is the phase prompt itself, ending at the commit gate. The verify
# stage is a second fresh-context session — Codex gpt-5.6-terra at high
# whatever the build's engine (codex job 2; DISPATCH_VERIFY_ENGINE and
# DISPATCH_VERIFY_MODEL exist only so stub chains and tests can pin it) —
# that checks the committed job against its done check and answers
# `VERIFY: PASS`, `VERIFY: INCONCLUSIVE: <reason>`, or
# `VERIFY: FAIL: <reason>` on its last line. The next unit may start while it
# runs, but runner-owned command wrappers hold that unit's dev build/restart
# until the verifier settles or reaches its 20-minute cap.
# A phase file that carries `<!-- verify: no -->` in its header skips its
# verify stage. A failing verify is recorded on that unit without touching
# the build already in flight; the chain continues and its terminal wake
# carries every failed verdict with an exact repair resume point.
#
# Watchdog events carry projectPath and phases so a server that restarted
# mid-chain (and lost its in-memory chain registry) re-registers the chain
# from the event itself; terminal events (completed/stopped/failed) retry
# for the better part of an hour so the chain-end planner wake is never lost.
set -u

RUNNER_PATH="${0:A}"
SCRIPT_DIR="${RUNNER_PATH:h}"
RUNNER_START_HASH=$(/usr/bin/shasum -a 256 "$RUNNER_PATH" | awk '{print $1}')
NODE=$(command -v node || echo /usr/local/bin/node)
eval "$("$NODE" "$SCRIPT_DIR/../../shared/runtime-anchors.js" --shell)"

SERVER_URL="${DISPATCH_SERVER_URL:-http://127.0.0.1:4747}"
DB_PATH="${DISPATCH_DB_PATH:-$COMMAND_CENTER_RUNTIME_DATA_DIR/auth.db}"

# Hard per-unit ceilings. Tests may lower either value through the matching
# DISPATCH_ override; production defaults remain named and visible here.
UNIT_MODEL_TURN_BUDGET="${DISPATCH_UNIT_MODEL_TURN_BUDGET:-160}"
UNIT_WALL_TIME_BUDGET_SECS="${DISPATCH_UNIT_WALL_TIME_BUDGET_SECS:-10800}"
LIMIT_RETRY_CAP="${DISPATCH_LIMIT_RETRY_CAP:-4}"
[[ "$UNIT_MODEL_TURN_BUDGET" == <1-> && "$UNIT_WALL_TIME_BUDGET_SECS" == <1-> \
  && "$LIMIT_RETRY_CAP" == <1-> ]] \
  || { print -u2 "dispatch-chain-runner: unit budgets and retry cap must be positive integers"; exit 64; }
DISPATCH_RUN_DATE="${DISPATCH_RUN_DATE:-$(date +%Y%m%d)}"
export DISPATCH_RUN_DATE

[[ $# -ge 3 ]] || { print -u2 "usage: dispatch-chain-runner <repo> <slug> <phase-file ...>"; exit 64; }
REPO="$1"; SLUG="$2"; shift 2
typeset -a PHASE_FILES
PHASE_FILES=("$@")

cd "$REPO" || { print -u2 "dispatch-chain-runner: cannot cd to $REPO"; exit 66; }
DISPATCH_RUN_SUMMARY_PATH="${DISPATCH_RUN_SUMMARY_PATH:-$HOME/Projects/spoton-worker/planner/${REPO:t}/sessions/${DISPATCH_RUN_DATE}-${SLUG}-summary.md}"
export DISPATCH_RUN_SUMMARY_PATH

# Chain-level engine/model/effort from the env: the fallback for units whose
# header names none. DISPATCH_MODEL applies only to units on the chain's
# engine (a Claude model id means nothing to a Codex unit and vice versa).
CHAIN_ENGINE="${DISPATCH_ENGINE:-claude}"
[[ "$CHAIN_ENGINE" == "claude" || "$CHAIN_ENGINE" == "codex" ]] \
  || { print -u2 "dispatch-chain-runner: DISPATCH_ENGINE must be claude or codex"; exit 64; }
CHAIN_MODEL="${DISPATCH_MODEL:-}"
CHAIN_EFFORT="${DISPATCH_EFFORT:-high}"
FALLBACK_MODEL="claude-opus-4-8"
CLAUDE_DEFAULT_MODEL="claude-opus-5"
CODEX_DEFAULT_MODEL="gpt-5.6-sol"
# Headless Claude units are unattended, so every normal work tool is explicit.
# acceptEdits keeps Claude on its native file tools while the PreToolUse hook
# still gets the final say over destructive Bash commands.
CLAUDE_PERMISSION_MODE="acceptEdits"
CLAUDE_ALLOWED_TOOLS="Bash,WebFetch,WebSearch,Agent,Skill,ToolSearch,Monitor,TaskOutput,Read,Edit,Write,Glob,Grep,NotebookEdit,TaskCreate,TaskUpdate,TaskList,TaskGet"

# The verify stage runs on Terra regardless of the build's engine; the two
# overrides exist only for stub chains and tests.
VERIFY_ENGINE="${DISPATCH_VERIFY_ENGINE:-codex}"
[[ "$VERIFY_ENGINE" == "claude" || "$VERIFY_ENGINE" == "codex" ]] \
  || { print -u2 "dispatch-chain-runner: DISPATCH_VERIFY_ENGINE must be claude or codex"; exit 64; }
if [[ "$VERIFY_ENGINE" == "codex" ]]; then
  VERIFY_MODEL="${DISPATCH_VERIFY_MODEL:-gpt-5.6-terra}"
else
  VERIFY_MODEL="${DISPATCH_VERIFY_MODEL:-$CLAUDE_DEFAULT_MODEL}"
fi
VERIFY_EFFORT=high
VERIFY_CAP_SECS="${DISPATCH_VERIFY_CAP_SECS:-1200}"
[[ "$VERIFY_CAP_SECS" == <1-> ]] \
  || { print -u2 "dispatch-chain-runner: DISPATCH_VERIFY_CAP_SECS must be a positive integer"; exit 64; }

# Both CLIs resolve up front; a unit whose engine is missing stops the chain
# at that unit with a journal line instead of at launch.
CLAUDE_BIN=$(command -v claude)
CODEX_BIN=$(command -v codex)
REAL_NPM=$(command -v npm)
REAL_LAUNCHCTL=$(command -v launchctl)

# Header value `<!-- key: value -->` from a prompt file's first 4 KB, or empty.
header_value() {
  python3 - "$1" "$2" <<'PYEOF'
import re, sys
head = open(sys.argv[1], encoding='utf-8', errors='replace').read(4096)
m = re.search(r'<!--\s*' + re.escape(sys.argv[2]) + r':\s*(.*?)\s*-->', head, re.I)
print(m.group(1) if m else '')
PYEOF
}

# A rerun owns fresh punch-list progress. When its prompt names a Job/Phase,
# reset only that section's checked boxes and land the reset before the build
# baseline so the worker's commit gate cannot mistake this docs commit for the
# unit's implementation commit.
reset_superseded_job() {
  local reset_info reset_file reset_job reset_count
  reset_info=$(python3 - "$1" "$REPO" <<'PYEOF'
import os, pathlib, re, sys, tempfile

prompt = pathlib.Path(sys.argv[1]).read_text(errors='replace')
repo = pathlib.Path(sys.argv[2]).resolve()
match = re.search(r'\b(?:Job|Phase)\s+(\d+)\s+of\s+(PUNCHLIST_[\w.-]+\.md)', prompt)
if not match:
    raise SystemExit(0)
job, filename = int(match.group(1)), match.group(2)
target = (repo / filename).resolve()
if os.path.commonpath([repo, target]) != str(repo) or not target.is_file():
    raise SystemExit(f'named punch list is not a file inside the repo: {filename}')

lines = target.read_text().splitlines(keepends=True)
start = -1
level = 0
heading_pattern = re.compile(rf'^(#{{1,6}})\s+(?:Job|Phase)\s+{job}(?:\D|$)', re.I)
for index, line in enumerate(lines):
    heading = heading_pattern.match(line)
    if heading:
        start = index + 1
        level = len(heading.group(1))
        break
if start < 0:
    raise SystemExit(f'could not find Job {job} in {filename}')

changed = 0
for index in range(start, len(lines)):
    heading = re.match(r'^(#{1,6})\s+', lines[index])
    if heading and len(heading.group(1)) <= level:
        break
    reset, count = re.subn(r'^(\s*-\s*)\[[xX]\]', r'\1[ ]', lines[index])
    if count:
        lines[index] = reset
        changed += count

if changed:
    mode = target.stat().st_mode
    with tempfile.NamedTemporaryFile('w', dir=target.parent, delete=False) as output:
        output.writelines(lines)
        temporary = output.name
    os.chmod(temporary, mode)
    os.replace(temporary, target)
print(f'{filename}\t{job}\t{changed}')
PYEOF
) || return $?
  [[ -n "$reset_info" ]] || return 0
  IFS=$'\t' read -r reset_file reset_job reset_count <<< "$reset_info"
  [[ "$reset_count" == <1-> ]] || return 0
  git -C "$REPO" commit --only -q -m "docs(dispatch): reset job $reset_job for $SLUG" -- "$reset_file" || return $?
  journal "phase $PHASE_NUM/$TOTAL" "reset" "Job $reset_job starts from zero in $reset_file ($reset_count checks; own pathspec commit)"
}

# Per-unit engine, model and effort: header, then env, then engine default.
# Sets UNIT_ENGINE, UNIT_MODEL, UNIT_EFFORT, UNIT_BIN for the prompt file $1.
unit_settings() {
  local engine model effort
  engine=$(header_value "$1" engine | tr '[:upper:]' '[:lower:]')
  UNIT_ENGINE="${engine:-$CHAIN_ENGINE}"
  model=$(header_value "$1" model)
  if [[ -z "$model" && "$UNIT_ENGINE" == "$CHAIN_ENGINE" ]]; then
    model="$CHAIN_MODEL"
  fi
  if [[ -z "$model" ]]; then
    [[ "$UNIT_ENGINE" == "codex" ]] && model="$CODEX_DEFAULT_MODEL" || model="$CLAUDE_DEFAULT_MODEL"
  fi
  UNIT_MODEL="$model"
  effort=$(header_value "$1" effort | tr '[:upper:]' '[:lower:]')
  UNIT_EFFORT="${effort:-$CHAIN_EFFORT}"
  [[ "$UNIT_ENGINE" == "codex" ]] && UNIT_BIN="$CODEX_BIN" || UNIT_BIN="$CLAUDE_BIN"
}

# Session-limit resilience (ui10 phase 1): a limit-exit never trips the commit
# gate. CSWAP_PATH override mirrors server/modules/accounts.
CSWAP_BIN="${CSWAP_PATH:-$HOME/.local/bin/cswap}"
MCP_EMPTY="$HOME/forge-logs/mcp-empty.json"
[ -f "$MCP_EMPTY" ] || printf '{"mcpServers":{}}' > "$MCP_EMPTY"
LIMIT_PATTERN='hit your session limit|session limit reached|usage limit reached|reached your .* limit|out of usage credits|spend limit'
# Codex usage-limit exits (codex job 2): the "hit your usage limit" message
# family. The runner waits for the reset in the unit's own rollout, or
# DISPATCH_CODEX_LIMIT_BACKOFF seconds when no reading exists, then retries;
# a reset further out than 12 hours (a weekly cap) stops the chain instead.
CODEX_LIMIT_PATTERN='usage limit|usage_limit'
CODEX_LIMIT_BACKOFF="${DISPATCH_CODEX_LIMIT_BACKOFF:-1800}"
CODEX_LIMIT_STOP_SECS=$((12 * 3600))
# A monthly spend cap (claude.ai billing) is invisible to cswap's usage
# percentages, so a capped account looks fresh and recovery would bounce
# straight back to it. Spend-cap exits park the account (ui14 job 8).
SPEND_PATTERN='spend limit'
PARK_DIR="${CSWAP_PARK_DIR:-$HOME/forge-logs/cswap-parked}"
# Long-park escalation: after this many wait cycles with no account headroom,
# one decision-needed fleet notification says the chain is parked.
PARK_ESCALATE_CYCLES="${DISPATCH_PARK_ESCALATE_CYCLES:-3}"

# API key from server config; keep it out of argv (curl reads a header file).
API_KEY=$(/usr/bin/sqlite3 "$DB_PATH" "SELECT api_key FROM api_keys WHERE is_active=1 ORDER BY id LIMIT 1" 2>/dev/null)
[[ -n "$API_KEY" ]] || { print -u2 "dispatch-chain-runner: no active API key in server config"; exit 78; }
HEADER_FILE=$(mktemp)
chmod 600 "$HEADER_FILE"
print -r -- "header = \"x-api-key: $API_KEY\"" > "$HEADER_FILE"
trap 'rm -f "$HEADER_FILE"' EXIT

JOURNAL_DIR="$HOME/forge-logs/$SLUG"
mkdir -p "$JOURNAL_DIR"
JOURNAL="$JOURNAL_DIR/JOURNAL.md"
APPEND_DIR="$JOURNAL_DIR/append"
journal() { print -r -- "$(date '+%Y-%m-%d %H:%M') | $1 | $2 | $3" >> "$JOURNAL"; }

# Build sessions get a private PATH prefix that gates only commands capable of
# rebuilding or restarting dev. Verifiers keep the ordinary PATH, so their own
# done checks can run while the next unit reads and edits. The atomic report
# directory makes one hold journal line even when npm and launchctl overlap.
DEV_GUARD_DIR="$JOURNAL_DIR/dev-guard"
VERIFY_HOLD_FILE="$JOURNAL_DIR/verify.hold"
VERIFY_HOLD_REPORTED="$JOURNAL_DIR/verify-hold-reported"
prepare_dev_guard() {
  mkdir -p "$DEV_GUARD_DIR"
  cat > "$DEV_GUARD_DIR/dispatch-dev-hold" <<'GUARD_EOF'
#!/bin/zsh
[[ -f "$DISPATCH_VERIFY_HOLD_FILE" ]] || exit 0
if mkdir "$DISPATCH_VERIFY_HOLD_REPORTED" 2>/dev/null; then
  print -r -- "$(date '+%Y-%m-%d %H:%M') | $DISPATCH_VERIFY_HOLD_LABEL | hold | next unit dev rebuild/restart waits for the verifier or its cap" >> "$DISPATCH_VERIFY_HOLD_JOURNAL"
fi
while [[ -f "$DISPATCH_VERIFY_HOLD_FILE" ]]; do /bin/sleep 0.1; done
GUARD_EOF
  cat > "$DEV_GUARD_DIR/npm" <<'GUARD_EOF'
#!/bin/zsh
if [[ "${1:-}" == run && ( "${2:-}" == build* || "${2:-}" == dev || "${2:-}" == server:dev || "${2:-}" == client ) ]]; then
  "$DISPATCH_DEV_GUARD_DIR/dispatch-dev-hold"
fi
[[ -n "$DISPATCH_REAL_NPM" ]] || { print -u2 "dispatch: npm is not on PATH"; exit 127; }
exec "$DISPATCH_REAL_NPM" "$@"
GUARD_EOF
  cat > "$DEV_GUARD_DIR/launchctl" <<'GUARD_EOF'
#!/bin/zsh
"$DISPATCH_DEV_GUARD_DIR/dispatch-dev-hold"
[[ -n "$DISPATCH_REAL_LAUNCHCTL" ]] || { print -u2 "dispatch: launchctl is not on PATH"; exit 127; }
exec "$DISPATCH_REAL_LAUNCHCTL" "$@"
GUARD_EOF
  chmod 700 "$DEV_GUARD_DIR/dispatch-dev-hold" "$DEV_GUARD_DIR/npm" "$DEV_GUARD_DIR/launchctl"
}
prepare_dev_guard

# Applied inside a background build subshell immediately before exec. The
# parent runner and verifier environments remain untouched.
apply_build_guard() {
  [[ "${1:-}" == build ]] || return 0
  export PATH="$DEV_GUARD_DIR:$PATH"
  export DISPATCH_DEV_GUARD_DIR="$DEV_GUARD_DIR"
  export DISPATCH_REAL_NPM="$REAL_NPM"
  export DISPATCH_REAL_LAUNCHCTL="$REAL_LAUNCHCTL"
  export DISPATCH_VERIFY_HOLD_FILE="$VERIFY_HOLD_FILE"
  export DISPATCH_VERIFY_HOLD_REPORTED="$VERIFY_HOLD_REPORTED"
  export DISPATCH_VERIFY_HOLD_JOURNAL="$JOURNAL"
  export DISPATCH_VERIFY_HOLD_LABEL="verify $VERIFY_NUM/$TOTAL"
}

TOTAL=${#PHASE_FILES[@]}
RESUME_FROM="${DISPATCH_RESUME_FROM:-1}"
[[ "$RESUME_FROM" == <1-> ]] || { print -u2 "dispatch-chain-runner: DISPATCH_RESUME_FROM must be a 1-based index"; exit 64; }
RESUME_STATE="$JOURNAL_DIR/resume.json"

# Persist the exact prompt list and runner settings for `dispatch resume`.
# Appended prompts extend this file when the runner consumes them.
save_resume_state() {
  local next_phase="${1:-$RESUME_FROM}" phase_count=${#PHASE_FILES[@]}
  python3 - "$RESUME_STATE.tmp" "$REPO" "$SLUG" "$DISPATCH_RUN_DATE" "$DISPATCH_RUN_SUMMARY_PATH" "$CHAIN_ENGINE" "$CHAIN_MODEL" "$CHAIN_EFFORT" \
      "$VERIFY_ENGINE" "$VERIFY_MODEL" "${DISPATCHING_SESSION_ID:-}" "$next_phase" "${CHAIN_BASE:-}" \
      "$VERIFY_INCONCLUSIVE_COUNT" "$phase_count" "${PHASE_FILES[@]}" "${VERIFY_FAILURES[@]}" <<'PYEOF'
import json, os, sys
out, repo, slug, run_date, summary_path, engine, model, effort, verify_engine, verify_model, dispatching_session_id, next_phase, chain_base, verify_inconclusive_count, phase_count, *rest = sys.argv[1:]
phase_count = int(phase_count)
files = rest[:phase_count]
verify_failures = rest[phase_count:]
with open(out, 'w', encoding='utf-8') as handle:
    json.dump({
        'repo': repo,
        'slug': slug,
        'runDate': run_date,
        'summaryPath': summary_path,
        'engine': engine,
        'model': model,
        'effort': effort,
        'verifyEngine': verify_engine,
        'verifyModel': verify_model,
        'dispatchingSessionId': dispatching_session_id,
        'phaseFiles': files,
        'resumeFrom': int(next_phase),
        'chainBase': chain_base,
        'verifyInconclusiveCount': int(verify_inconclusive_count),
        'verifyFailures': verify_failures,
    }, handle)
    handle.write('\n')
os.replace(out, os.path.join(os.path.dirname(out), 'resume.json'))
PYEOF
}

# POST an event body to a watchdog path, retrying while the server is down
# (promote restart). $3 is the attempt budget; boundary events use a short
# one and keep going, terminal events retry long because the chain-end wake
# must never be lost.
api_post() {
  # $1 path, $2 json body, $3 attempts
  local attempt=1 max="${3:-3}" delay=5
  while true; do
    if curl -sf -K "$HEADER_FILE" -m 30 -X POST "$SERVER_URL$1" \
        -H 'Content-Type: application/json' -d "$2" >/dev/null 2>&1; then
      return 0
    fi
    if [[ $attempt -ge $max ]]; then
      journal watchdog "unreachable" "gave up on POST $1 after $max attempts"
      return 1
    fi
    sleep $delay
    [[ $delay -lt 30 ]] && delay=$((delay * 2))
    attempt=$((attempt + 1))
  done
}

# Reads the persisted chain preference immediately before a build launch. A
# transient watchdog outage safely falls back to the standard tier for that
# unit and is visible in the chain journal; the next unit reads again.
read_chain_fast_mode() {
  local response enabled
  if ! response=$(curl -sf -K "$HEADER_FILE" -m 30 "$SERVER_URL/api/watchdog/chains/$SLUG/fast" 2>/dev/null); then
    journal "phase $PHASE_NUM/$TOTAL" "fast-read" "watchdog unavailable; launching this unit on the standard tier"
    print -r -- 0
    return 0
  fi
  enabled=$(RESPONSE_BODY="$response" python3 -c 'import json, os; print(1 if json.loads(os.environ["RESPONSE_BODY"])["data"]["fastMode"] is True else 0)' 2>/dev/null)
  print -r -- "${enabled:-0}"
}

# Reads the promote-owned boundary flag. An unavailable watchdog is visible
# but never interpreted as permission to stop; promote will keep waiting and
# the next boundary reads the durable record again.
read_chain_hold_reason() {
  local response reason
  if ! response=$(curl -sf -G -K "$HEADER_FILE" -m 30 \
      --data-urlencode "projectPath=$REPO" \
      "$SERVER_URL/api/watchdog/chains/$SLUG/hold" 2>/dev/null); then
    journal "phase $PHASE_NUM/$TOTAL" "hold-read" "watchdog unavailable; continuing to the next clean boundary"
    print -r -- ""
    return 0
  fi
  reason=$(RESPONSE_BODY="$response" python3 -c 'import json, os; data=json.loads(os.environ["RESPONSE_BODY"])["data"]; print(data.get("reason", "") if data.get("requested") else "")' 2>/dev/null)
  print -r -- "${reason:-}"
}

# Names queued append files that a terminal chain can no longer consume.
# Prints a tab-separated count and terminal-notice sentence.
orphaned_append_report() {
  local -a files
  local count names
  files=("$APPEND_DIR"/*.md(N))
  count=${#files[@]}
  if [[ $count -eq 0 ]]; then
    print -r -- $'0\t'
    return 0
  fi
  names=$(print -rl -- "${files[@]:t}" | paste -sd ', ' -)
  print -r -- "$count"$'\t'"$count queued append file$([[ $count -eq 1 ]] || print s) remain under $APPEND_DIR: $names"
}

# Every event carries projectPath and phases so a restarted server can
# re-register the chain it lost with the event itself. Terminal events also
# report queued appends in both the journal and the notice summary tail.
event_body() {
  # $1 event, $2 phase (or empty), $3 summaryTail json string (or empty),
  # $4 commit short hash (or empty), $5 commit subject (or empty),
  # $6 exact verifier verdict (PASS|FAIL|INCONCLUSIVE, or empty)
  local event="$1" phase="$2" tail="$3" orphan_count=0 orphan_detail="" orphan_report
  if [[ "$event" == completed || "$event" == stopped || "$event" == failed ]]; then
    orphan_report=$(orphaned_append_report)
    IFS=$'\t' read -r orphan_count orphan_detail <<< "$orphan_report"
    if [[ $orphan_count -gt 0 ]]; then
      journal run "orphaned-appends" "$orphan_detail"
    fi
  fi
  python3 - "$event" "$phase" "$tail" "$REPO" "$TOTAL" "${4:-}" "${5:-}" "${DISPATCHING_SESSION_ID:-}" "${UNIT_FAST_MODE:-0}" "${6:-}" "$orphan_count" "$orphan_detail" <<'PYEOF'
import json, sys
event, phase, tail, repo, total, commit_hash, commit_subject, dispatching_session_id, fast_mode, verdict, orphan_count, orphan_detail = sys.argv[1:13]
body = {'event': event, 'projectPath': repo, 'phases': int(total)}
if dispatching_session_id:
    body['dispatchingSessionId'] = dispatching_session_id
if phase:
    body['phase'] = int(phase)
summary = json.loads(tail) if tail else ''
if orphan_detail:
    summary = f'{summary}\n\n{orphan_detail}'.strip()
if summary:
    body['summaryTail'] = summary
if int(orphan_count):
    body['orphanedAppends'] = int(orphan_count)
if commit_hash:
    body['commit'] = {'hash': commit_hash, 'subject': commit_subject}
if event == 'phase-start':
    body['fastMode'] = fast_mode == '1'
if verdict:
    body['verdict'] = verdict
print(json.dumps(body))
PYEOF
}

json_string() { python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }

# Chrome-cap queueing hook: browser-phase chains wait for a Chrome slot
# instead of launching a fourth instance. The wait is bounded (ui14 job 7):
# past chrome-slot-wait's ceiling the chain stops with a journal line and a
# stopped event instead of queueing forever.
wait_for_chrome_slot() {
  local helper="$HOME/.local/bin/chrome-slot-wait"
  [[ -x "$helper" ]] || return 0
  "$helper" && return 0
  journal "phase $PHASE_NUM/$TOTAL" "STOPPED" "chrome-slot-wait hit its ceiling with no free Chrome slot before $PHASE_NAME"
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body stopped $PHASE_NUM "$(print -rn -- "Phase $PHASE_NUM ($PHASE_NAME) never got a Chrome slot: chrome-slot-wait hit its ceiling." | json_string)")" 80
  exit 2
}

# ----- session-limit resilience (ui10 phase 1) ------------------------------
# When claude exits nonzero with the session-limit message in the phase log,
# the runner switches to the next enabled account with 5h headroom via cswap
# (order: current, then remaining slots), mirrors the fresh credential into
# this instance's scoped Keychain, and retries the phase; with no viable
# account it sleeps until the earliest 5h reset and retries then.

# After a cswap switch the *default* Keychain item holds the new account, but
# an instance scoped by CLAUDE_CONFIG_DIR reads its own service. Mirror the
# way server/modules/accounts does: service suffix is sha256(NFC(config
# dir))[:8], credential travels via `security -i` + hex payload, never argv.
mirror_keychain() {
  [[ -n "${CLAUDE_CONFIG_DIR:-}" ]] || return 0
  local digest creds hex
  digest=$(python3 -c 'import hashlib,os,unicodedata;print(hashlib.sha256(unicodedata.normalize("NFC",os.environ["CLAUDE_CONFIG_DIR"]).encode()).hexdigest()[:8])') || return 1
  creds=$(/usr/bin/security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null)
  [[ -n "$creds" ]] || return 1
  hex=$(print -rn -- "$creds" | /usr/bin/xxd -p -u | tr -d '\n')
  print -r -- "add-generic-password -U -a \"$USER\" -s \"Claude Code-credentials-$digest\" -X $hex" \
    | /usr/bin/security -i >/dev/null 2>&1 || return 1
  print -r -- "$creds" > "$CLAUDE_CONFIG_DIR/.credentials.json" \
    && chmod 600 "$CLAUDE_CONFIG_DIR/.credentials.json"
}

# Recovery decision from `cswap list --json`: prints "stay", "switch <num>
# <email>", or "wait <seconds> <until>". Headroom = readable 5h window under
# 90%. An account whose quota reads unreadable is tried after readable ones —
# the 2026-08-23 death taught that unreadable is not exhausted. $1=1 forces
# the wait branch (guard when every account was already tried this phase).
pick_recovery() {
  local listing
  listing=$(env -u CLAUDE_CONFIG_DIR "$CSWAP_BIN" list --json 2>/dev/null)
  FORCE_WAIT="${1:-}" CSWAP_LISTING="$listing" PARK_DIR="$PARK_DIR" python3 - <<'PYEOF'
import datetime, json, os, pathlib, sys
try:
    data = json.loads(os.environ.get('CSWAP_LISTING') or '')
except Exception:
    print("wait 1800 unknown-cswap-list-unreadable")
    sys.exit(0)
month = datetime.datetime.now().strftime('%Y-%m')
parked = set()
park_dir = pathlib.Path(os.environ['PARK_DIR'])
if park_dir.is_dir():
    for marker in park_dir.iterdir():
        try:
            if marker.is_file() and marker.name.isdigit() and marker.read_text().split()[0] == month:
                parked.add(int(marker.name))
        except (OSError, IndexError):
            pass
accounts = [
    a for a in data.get('accounts', [])
    if not a.get('disabled') and a.get('number') not in parked
]
current = data.get('activeAccountNumber')
ordered = sorted(accounts, key=lambda a: (a.get('number') != current, a.get('number') or 0))
five = lambda a: ((a.get('usage') or {}).get('fiveHour') or {})
if os.environ.get('FORCE_WAIT') != '1':
    for a in ordered:
        pct = five(a).get('pct')
        if isinstance(pct, (int, float)) and pct < 90:
            print('stay' if a.get('number') == current else f"switch {a.get('number')} {a.get('email', '')}")
            sys.exit(0)
    for a in ordered:
        if a.get('number') != current and not isinstance(five(a).get('pct'), (int, float)):
            print(f"switch {a.get('number')} {a.get('email', '')} (quota unreadable, trying anyway)")
            sys.exit(0)
resets = []
for a in accounts:
    iso = five(a).get('resetsAt')
    if iso:
        try:
            dt = datetime.datetime.fromisoformat(iso.replace('Z', '+00:00'))
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=datetime.timezone.utc)
            resets.append(dt)
        except ValueError:
            pass
if resets:
    earliest = min(resets)
    now = datetime.datetime.now(datetime.timezone.utc)
    secs = max(60, int((earliest - now).total_seconds()) + 60)
    print(f"wait {secs} {earliest.isoformat()}")
else:
    print("wait 1800 unknown-no-reset-times")
PYEOF
}

# Spend-cap parking is runner-owned: a marker holds the capped account out of
# this runner's automatic picks without changing cswap's Willem-owned enabled
# flag. The marker records the billing month and email in the established
# `YYYY-MM email` format.
park_spend_capped() {
  local listing current email
  listing=$(env -u CLAUDE_CONFIG_DIR "$CSWAP_BIN" list --json 2>/dev/null)
  current=$(CSWAP_LISTING="$listing" python3 -c 'import json,os
d=json.loads(os.environ["CSWAP_LISTING"] or "{}"); n=d.get("activeAccountNumber")
print("" if n is None else n)' 2>/dev/null)
  [[ -n "$current" ]] || { journal "$1" "park" "spend limit hit but cswap cannot name the active account; not parked"; return 1; }
  email=$(CSWAP_LISTING="$listing" python3 -c 'import json,os
d=json.loads(os.environ["CSWAP_LISTING"]); print(next((a.get("email","") for a in d.get("accounts",[]) if a.get("number")==d.get("activeAccountNumber")),""))' 2>/dev/null)
  mkdir -p "$PARK_DIR" || { journal "$1" "park" "could not create $PARK_DIR; capped account remains in runner rotation"; return 1; }
  print -r -- "$(date +%Y-%m) $email" > "$PARK_DIR/$current" \
    || { journal "$1" "park" "could not write marker for account $current; capped account remains in runner rotation"; return 1; }
  journal "$1" "park" "monthly spend limit on account $current ($email); runner marker skips it until $(date +%Y-%m) ends; cswap enabled flag unchanged"
}

# Markers from an earlier billing month expire at runner start. Nothing calls
# cswap enable: only Willem changes account enabled flags.
unpark_stale() {
  local marker month
  for marker in "$PARK_DIR"/*(N.); do
    month=$(cut -d' ' -f1 "$marker")
    [[ "$month" != "$(date +%Y-%m)" ]] || continue
    rm -f "$marker"
    [[ -e "$marker" ]] || journal run "unpark" "account ${marker:t} marker from $month expired; runner rotation restored without changing cswap"
  done
}

LIMIT_STREAK=0
LIMIT_STREAK_KEY=""
WAIT_CYCLES=0
WAIT_TOTAL=0
PARK_ESCALATED=0

# Account recovery after a limit exit, shared by both stages: $1 is the
# journal label ("phase N/T" or "verify N/T"), $2 the unit number, $3 its
# name, $4 the stage log, $5 the stage (build|verify). Parks a spend-capped
# account, then switches, stays, or sleeps out the reset; the `limit`
# watchdog event keeps the chain running and wakes the planner with
# "auto-recovering", not "FAILED". A verify-stage limit event carries no
# phase, so it never moves the chain's current job. Exits the chain only when
# cswap is missing. The caller re-runs the stage afterwards.
recover_from_limit() {
  local label="$1" unit="$2" name="$3" log="$4" stage="${5:-build}"
  local event_phase="$unit" what="Phase $unit ($name)"
  if [[ "$stage" == verify ]]; then
    event_phase=""
    what="The verify of job $unit ($name)"
  fi
  if [[ "$LIMIT_STREAK_KEY" != "$stage:$unit" ]]; then
    LIMIT_STREAK_KEY="$stage:$unit"
    LIMIT_STREAK=0
    WAIT_CYCLES=0
    WAIT_TOTAL=0
    PARK_ESCALATED=0
  fi
  LIMIT_STREAK=$((LIMIT_STREAK + 1))
  journal "$label" "limit" "claude exited on the session limit (attempt $LIMIT_STREAK); auto-recovering"
  if [[ $LIMIT_STREAK -ge $LIMIT_RETRY_CAP ]]; then
    report_claude_read_usage
    journal "$label" "STOPPED" "session limit retry cap reached after $LIMIT_STREAK limit waits; decision-needed sent"
    api_post "/api/watchdog/notify" "$(python3 - "$SLUG" "$unit" "$TOTAL" "$name" "$LIMIT_STREAK" <<'PYEOF'
import json, sys
slug, phase, total, name, count = sys.argv[1:6]
print(json.dumps({
    'kind': 'decision-needed',
    'title': f'Chain {slug} stopped after repeated limit waits',
    'body': f'Job {phase} of {total} ({name}) reached the per-unit retry cap after {count} limit waits. The chain stopped with its work left in place for a decision.',
}))
PYEOF
)" 3
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body stopped "$unit" "$(print -rn -- "Job $unit ($name) reached the per-unit retry cap after $LIMIT_STREAK limit waits." | json_string)")" 80
    exit 2
  fi
  if [[ ! -x "$CSWAP_BIN" ]]; then
    report_claude_read_usage
    journal "$label" "FAILED" "limit hit but cswap missing at $CSWAP_BIN; cannot auto-recover"
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body failed $unit "$(print -rn -- "Phase $unit ($name) hit the session limit and auto-recovery is unavailable (cswap missing at $CSWAP_BIN)." | json_string)")" 80
    exit 1
  fi
  if grep -qiE "$SPEND_PATTERN" "$log"; then
    park_spend_capped "$label"
  fi
  local force_wait=""
  [[ $LIMIT_STREAK -gt 3 ]] && force_wait=1
  RECOVERY=$(pick_recovery "$force_wait")
  case "${RECOVERY%% *}" in
    switch)
      local target
      target=$(print -r -- "$RECOVERY" | awk '{print $2}')
      if env -u CLAUDE_CONFIG_DIR "$CSWAP_BIN" switch "$target" --json >/dev/null 2>&1; then
        journal "$label" "switch" "switched account: ${RECOVERY#switch }"
      else
        journal "$label" "switch" "cswap switch $target failed; retrying on current account"
      fi
      mirror_keychain \
        && journal "$label" "mirror" "scoped Keychain + .credentials.json refreshed for ${CLAUDE_CONFIG_DIR:-default profile (no-op)}" \
        || journal "$label" "mirror" "keychain mirror failed; scoped instances may lag one account behind"
      ;;
    stay)
      journal "$label" "switch" "current account already has 5h headroom; retrying without a switch"
      ;;
    wait)
      WAIT_SECS=$(print -r -- "$RECOVERY" | awk '{print $2}')
      WAIT_UNTIL=$(print -r -- "$RECOVERY" | awk '{print $3}')
      WAIT_CYCLES=$((WAIT_CYCLES + 1))
      WAIT_TOTAL=$((WAIT_TOTAL + WAIT_SECS))
      journal "$label" "wait" "no account with 5h headroom; sleeping ${WAIT_SECS}s until $WAIT_UNTIL (wait cycle $WAIT_CYCLES)"
      if [[ $WAIT_CYCLES -ge $PARK_ESCALATE_CYCLES && $PARK_ESCALATED -eq 0 ]]; then
        PARK_ESCALATED=1
        journal "$label" "parked" "chain parked $WAIT_CYCLES wait cycles (${WAIT_TOTAL}s) with no account headroom; decision-needed sent"
        api_post "/api/watchdog/notify" "$(python3 - "$SLUG" "$unit" "$TOTAL" "$name" "$WAIT_CYCLES" "$WAIT_TOTAL" "$WAIT_UNTIL" <<'PYEOF'
import json, sys
slug, phase, total, name, cycles, waited, until = sys.argv[1:8]
hours = round(int(waited) / 3600, 1)
print(json.dumps({
    'kind': 'decision-needed',
    'title': f'Chain {slug} parked waiting for an account reset',
    'body': f'Job {phase} of {total} ({name}) has waited {cycles} cycles (about {hours} h) with no account under 90% of its 5h window; next retry after {until}. Raise a cap, enable an account, or stop the chain.',
}))
PYEOF
)" 3
      fi
      ;;
  esac
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body limit "$event_phase" "$(print -rn -- "$what hit the session limit; recovery: $RECOVERY." | json_string)")" 3
  if [[ "${RECOVERY%% *}" == "wait" ]]; then
    sleep "$WAIT_SECS"
  fi
}

# Counts completed model calls from the provider's durable session record.
# Claude assistant records are one model turn; Codex token_count records are
# one inference in the rollout. Missing/incomplete records safely count zero.
model_turn_count() {
  local engine="$1" session="$2" thread="${3:-}"
  ENGINE="$engine" SESSION_ID="$session" THREAD_ID="$thread" REPO_PATH="$REPO" \
    TURN_SOURCE_CACHE="$JOURNAL_DIR/model-turn-source-${session:-$thread}" python3 - <<'PYEOF'
import glob, json, os, pathlib

engine = os.environ['ENGINE']
identifier = os.environ['SESSION_ID'] if engine == 'claude' else os.environ.get('THREAD_ID', '')
if not identifier:
    print(0)
    raise SystemExit(0)
cache = pathlib.Path(os.environ['TURN_SOURCE_CACHE'])
paths = []
try:
    cached = cache.read_text().strip()
    if cached and os.path.isfile(cached):
        paths = [cached]
except OSError:
    pass
if not paths:
    root = os.path.expanduser('~/.claude/projects' if engine == 'claude' else '~/.codex/sessions')
    if engine == 'claude':
        project = os.environ['REPO_PATH'].replace('/', '-')
        candidate = os.path.join(root, project, f'{identifier}.jsonl')
        paths = [candidate] if os.path.isfile(candidate) else glob.glob(os.path.join(root, '**', f'{identifier}.jsonl'), recursive=True)
    else:
        paths = glob.glob(os.path.join(root, '**', f'rollout-*{identifier}.jsonl'), recursive=True)
    if paths:
        try:
            cache.write_text(paths[0])
        except OSError:
            pass
count = 0
for filename in paths:
    try:
        with open(filename, encoding='utf-8', errors='replace') as handle:
            for line in handle:
                try:
                    item = json.loads(line)
                except ValueError:
                    continue
                if engine == 'claude':
                    count += item.get('type') == 'assistant'
                elif item.get('type') == 'event_msg' and (item.get('payload') or {}).get('type') == 'token_count':
                    count += 1
    except OSError:
        pass
print(count)
PYEOF
}

# Counts Read tool calls for the one Claude session so a zero-Read unit leaves
# the audit signal requested by runner doctrine without changing behavior.
claude_read_tool_count() {
  SESSION_ID="$1" python3 - <<'PYEOF'
import glob, json, os

count = 0
pattern = os.path.expanduser(f'~/.claude/projects/**/{os.environ["SESSION_ID"]}.jsonl')
for filename in glob.glob(pattern, recursive=True):
    try:
        with open(filename, encoding='utf-8', errors='replace') as handle:
            for line in handle:
                try:
                    item = json.loads(line)
                except ValueError:
                    continue
                message = item.get('message') or {}
                for block in message.get('content') or []:
                    if isinstance(block, dict) and block.get('type') == 'tool_use' and block.get('name') == 'Read':
                        count += 1
    except OSError:
        pass
print(count)
PYEOF
}

report_claude_read_usage() {
  [[ "$UNIT_ENGINE" == claude ]] || return 0
  local reads
  reads=$(claude_read_tool_count "$SESSION_ID")
  [[ $reads -gt 0 ]] || journal "phase $PHASE_NUM/$TOTAL" "read-check" "Claude unit ended with zero Read tool calls"
}

# One headless claude session: $1 prompt file, $2 log, $3 session id, $4
# model, $5 effort. exec'd so a caller running it in the background holds
# claude's own pid (killable on a rewind). The two CLAUDE_CODE_ lines are
# load-bearing (runner doctrine): the first forces subagents synchronous so a
# turn cannot end while work runs, the second makes anything that slips
# through be waited on uncapped. Empty ANTHROPIC_API_KEY pins subscription
# auth. Fable phases carry the Opus 4.8 capacity fallback; a unit pinned to
# 4.8 carries none.
run_claude() {
  typeset -a fallback_args
  fallback_args=()
  [[ "$4" != "$FALLBACK_MODEL" ]] && fallback_args=(--fallback-model "$FALLBACK_MODEL")
  apply_build_guard "${7:-build}"
  # setsid puts the session in its own process group (pid == pgid, since the
  # exec keeps the pid) so a rewind can kill claude and everything it spawned.
  ANTHROPIC_API_KEY="" \
  CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1 \
  CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
    exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
    "$CLAUDE_BIN" -p --strict-mcp-config --mcp-config "$MCP_EMPTY" --model "$4" --effort "$5" "${fallback_args[@]}" \
    --session-id "$3" \
    --permission-mode "$CLAUDE_PERMISSION_MODE" \
    --allowedTools "$CLAUDE_ALLOWED_TOOLS" \
    < "$1" > "$2" 2>&1
}

# One headless Codex session with the same prompt/log/model/effort contract
# as run_claude ($3 is unused: Codex assigns its own thread id, which the
# runner reads back off the `--json` event stream in the log and announces).
# The prompt arrives on stdin; the final message lands in $2.last for the
# verifier's exact VERIFY line. Subagents stay off by explicit override so a
# config edit cannot turn them back on for dispatched units (codex job 2).
# $6 is 1 only for a build whose chain flag was on at this unit boundary.
# The standard tier is explicit for all other builds and every verify so a
# host-level fast preference cannot leak into unattended work.
run_codex() {
  local service_tier=default
  [[ "${6:-0}" == "1" ]] && service_tier=fast
  apply_build_guard "${7:-build}"
  exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
    "$CODEX_BIN" exec \
    --strict-config \
    --dangerously-bypass-approvals-and-sandbox \
    --json \
    -C "$REPO" \
    -m "$4" \
    -c model_reasoning_effort="$5" \
    -c service_tier="$service_tier" \
    -c features.fast_mode=true \
    -c features.multi_agent=false \
    -c 'mcp_servers={}' \
    -o "$2.last" \
    - \
    < "$1" > "$2" 2>&1
}

# $1 engine, then the run_claude contract: prompt, log, session id, model, effort.
run_engine() {
  local engine="$1"; shift
  if [[ "$engine" == "codex" ]]; then
    run_codex "$@"
  else
    run_claude "$@"
  fi
}

# Pre-tag a stage session: the id is announced to the server so the row
# exists tagged origin=dispatch (with the chain slug, unit, engine and model)
# before transcript discovery can index it untagged — before claude starts
# for Claude units, and the moment Codex reports its thread id for Codex
# units (the same id the rollout synchronizer indexes, so both are one row).
# $1 session id, $2 base commit, $3 unit, $4 stage (build|verify), $5
# provider, $6 model, $7 title (the prompt file's name header; a verify
# stage sends "Verify: <name>", codex job 5).
announce_session() {
  api_post "/api/watchdog/chains/$SLUG/sessions" "$(python3 - "$1" "$REPO" "$2" "$6" "$3" "$4" "$5" "$7" <<'PYEOF'
import json, sys
sid, repo, base, model, phase, stage, provider, title = sys.argv[1:9]
print(json.dumps({'sessionId': sid, 'projectPath': repo, 'baseCommit': base, 'model': model, 'phase': int(phase), 'stage': stage, 'provider': provider, 'title': title}))
PYEOF
)" 3
}

# Codex thread id off a `codex exec --json` log: waits up to 90 s for the
# thread.started event while the process ($2) lives. Prints the id or nothing.
wait_thread_id() {
  local i=0 id=""
  while [[ $i -lt 90 ]]; do
    id=$(grep -o '"thread_id":"[^"]*"' "$1" 2>/dev/null | head -1 | cut -d'"' -f4)
    [[ -n "$id" ]] && break
    kill -0 "$2" 2>/dev/null || break
    sleep 1
    i=$((i + 1))
  done
  print -r -- "$id"
}

# A strict-config Codex launch reaches thread.started only after accepting the
# request-scoped service_tier override. This checks that event in the unit's
# own JSON rollout before a fast build is allowed through the commit gate.
confirm_fast_rollout() {
  python3 - "$1" "$2" <<'PYEOF'
import json, sys
log, expected = sys.argv[1:3]
try:
    with open(log, encoding='utf-8', errors='replace') as handle:
        for line in handle:
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get('type') == 'thread.started' and event.get('thread_id') == expected:
                raise SystemExit(0)
except OSError:
    pass
raise SystemExit(1)
PYEOF
}

# ----- Codex usage-limit wait (codex job 2) --------------------------------
# Decision from the rate_limits block of the unit's own rollout (by thread
# id), else the newest rollout: prints "wait <secs> <until>" or "stop <until>
# <window-minutes>" (a reset past the 12 h ceiling: the weekly cap), or the
# fixed backoff when nothing is readable.
codex_limit_decision() {
  CODEX_THREAD="${1:-}" BACKOFF="$CODEX_LIMIT_BACKOFF" STOP_SECS="$CODEX_LIMIT_STOP_SECS" python3 - <<'PYEOF'
import datetime, glob, json, os, sys
home = os.path.expanduser('~/.codex/sessions')
thread = os.environ.get('CODEX_THREAD') or ''
files = glob.glob(os.path.join(home, '**', f'rollout-*{thread}.jsonl'), recursive=True) if thread else []
if not files:
    files = glob.glob(os.path.join(home, '**', 'rollout-*.jsonl'), recursive=True)
files.sort(key=lambda p: os.path.getmtime(p), reverse=True)
limits = None
for path in files[:1]:
    try:
        lines = open(path, encoding='utf-8', errors='replace').read().splitlines()
    except OSError:
        continue
    for line in reversed(lines):
        if '"rate_limits"' not in line:
            continue
        try:
            payload = json.loads(line).get('payload') or {}
        except ValueError:
            continue
        if payload.get('type') == 'token_count' and isinstance(payload.get('rate_limits'), dict):
            limits = payload['rate_limits']
            break
if not limits:
    print(f"wait {os.environ['BACKOFF']} unknown-no-rate-limits-readable")
    sys.exit(0)
# The exhausted window is the one the reading names, else any at 100%; a
# reading that shows headroom everywhere does not explain the exit, so the
# fixed backoff applies rather than a guess at a reset.
named = str(limits.get('rate_limit_reached_type') or '').lower()
windows = []
for key in ('primary', 'secondary'):
    w = limits.get(key)
    if not (isinstance(w, dict) and w.get('resets_at')):
        continue
    if key in named or (w.get('used_percent') or 0) >= 99:
        windows.append(w)
if not windows:
    print(f"wait {os.environ['BACKOFF']} unknown-no-exhausted-window")
    sys.exit(0)
hit = min(windows, key=lambda w: int(w['resets_at']))
reset = datetime.datetime.fromtimestamp(int(hit['resets_at']), datetime.timezone.utc)
now = datetime.datetime.now(datetime.timezone.utc)
secs = int((reset - now).total_seconds()) + 60
if secs > int(os.environ['STOP_SECS']):
    print(f"stop {reset.isoformat()} {hit.get('window_minutes') or '?'}")
else:
    print(f"wait {max(60, secs)} {reset.isoformat()}")
PYEOF
}

# A Codex unit exited on its usage limit: journal, a recovery notification
# (never a planner wake), then wait for the reset and let the caller re-run
# the stage on the uncommitted tree. Models and accounts are never switched.
# A weekly cap with no reset inside 12 hours stops the chain with a
# decision-needed notification naming Terra as the manual fallback.
# $1 journal label, $2 unit, $3 name, $4 stage (build|verify), $5 thread id.
wait_codex_limit() {
  local label="$1" unit="$2" name="$3" stage="${4:-build}" thread="${5:-}"
  local decision kind secs until what event_phase="$unit"
  what="Job $unit ($name)"
  [[ "$stage" == verify ]] && { what="The verify of job $unit ($name)"; event_phase=""; }
  decision=$(codex_limit_decision "$thread")
  kind="${decision%% *}"
  secs=$(print -r -- "$decision" | awk '{print $2}')
  until=$(print -r -- "$decision" | awk '{print $3}')
  if [[ "$kind" == stop ]]; then
    journal "$label" "STOPPED" "codex usage limit with no reset inside 12 h (window ${until}m resets $secs); weekly cap, Terra is the manual fallback"
    api_post "/api/watchdog/notify" "$(python3 - "$SLUG" "$unit" "$TOTAL" "$name" "$secs" <<'PYEOF'
import json, sys
slug, phase, total, name, until = sys.argv[1:6]
print(json.dumps({
    'kind': 'decision-needed',
    'title': f'Chain {slug} stopped on the Codex weekly cap',
    'body': f'Job {phase} of {total} ({name}) hit a Codex usage limit that does not reset until {until}. Re-dispatch on gpt-5.6-terra by hand, or wait for the reset.',
}))
PYEOF
)" 3
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body stopped "$unit" "$(print -rn -- "$what hit the Codex weekly usage cap (resets $secs); stopped, Terra is the manual fallback." | json_string)")" 80
    exit 2
  fi
  journal "$label" "limit" "codex exited on its usage limit; waiting ${secs}s until $until, then retrying"
  api_post "/api/watchdog/notify" "$(python3 - "$SLUG" "$unit" "$TOTAL" "$name" "$secs" "$until" <<'PYEOF'
import json, sys
slug, phase, total, name, secs, until = sys.argv[1:7]
print(json.dumps({
    'kind': 'recovery',
    'title': f'Chain {slug} waiting on a Codex usage limit',
    'body': f'Job {phase} of {total} ({name}) hit the Codex usage limit; retrying after {until} (about {round(int(secs) / 60)} min). No action needed.',
}))
PYEOF
)" 3
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body limit "$event_phase" "$(print -rn -- "$what hit the Codex usage limit; retrying after $until." | json_string)" | python3 -c 'import json,sys; b=json.load(sys.stdin); b["quiet"]=True; print(json.dumps(b))')" 3
  sleep "$secs"
}

# ----- verify stage (ui14 job 10) ------------------------------------------
BUILD_PID=""
VERIFY_PID=""
VERIFY_NUM=0
VERIFY_NAME=""
VERIFY_FILE=""
VERIFY_BASE_COMMIT=""
VERIFY_COMMIT=""
VERIFY_SUBJECT=""
VERIFY_RETRY=0
VERIFY_THREAD=""
VERIFY_DEADLINE=0
VERIFY_INCONCLUSIVE_COUNT=0
typeset -a VERIFY_FAILURES
VERIFY_FAILURES=()
PAUSING=0
PHASE_NUM=$((RESUME_FROM - 1))
PAUSE_REQUEST="$JOURNAL_DIR/pause.requested"
rm -f "$PAUSE_REQUEST"

# A boundary reload resumes from the state the old inode wrote immediately
# before exec. The verifier is settled first, so the only cross-inode runtime
# state is the chain baseline and the accumulated failed-verifier notices.
if [[ -n "${DISPATCH_RELOADING:-}" ]]; then
  CHAIN_BASE=$(python3 - "$RESUME_STATE" <<'PYEOF'
import json, sys
print(json.load(open(sys.argv[1], encoding='utf-8')).get('chainBase') or 'none')
PYEOF
)
  while IFS= read -r failure; do
    VERIFY_FAILURES+=("$failure")
  done < <(python3 - "$RESUME_STATE" <<'PYEOF'
import json, sys
for failure in json.load(open(sys.argv[1], encoding='utf-8')).get('verifyFailures', []):
    print(failure)
PYEOF
)
  VERIFY_INCONCLUSIVE_COUNT=$(python3 - "$RESUME_STATE" <<'PYEOF'
import json, sys
print(int(json.load(open(sys.argv[1], encoding='utf-8')).get('verifyInconclusiveCount') or 0))
PYEOF
)
else
  CHAIN_BASE=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo none)
fi
save_resume_state "$RESUME_FROM"

# Stops one stage and everything it spawned. Build and verify sessions each
# run in their own process group, so TERM reaches the whole stage before the
# same bounded KILL fallback the verify rewind uses.
stop_stage_for_pause() {
  local pid="$1" i=0
  [[ -n "$pid" ]] || return 0
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM -- -$pid 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    while kill -0 "$pid" 2>/dev/null && [[ $i -lt 30 ]]; do sleep 1; i=$((i + 1)); done
    kill -0 "$pid" 2>/dev/null && { kill -KILL -- -$pid 2>/dev/null || kill -KILL "$pid" 2>/dev/null; }
  fi
  wait "$pid" 2>/dev/null
}

# Parks the interrupted job on its stable pause branch, using the same WIP
# commit shape as a verify rewind, then returns the checkout to its prior
# branch. Repeated pauses of the same job replace the branch only after its
# earlier WIP has been restored into the tree.
park_paused_work() {
  local head main_branch branch state
  head=$(git -C "$REPO" rev-parse --short HEAD)
  main_branch=$(git -C "$REPO" rev-parse --abbrev-ref HEAD)
  branch="dispatch/$SLUG/job$PHASE_NUM-paused"
  if [[ -n "$(git -C "$REPO" status --porcelain)" ]]; then
    if git -C "$REPO" checkout -q -B "$branch" \
      && git -C "$REPO" add -A \
      && git -C "$REPO" commit -q --no-verify -m "wip(dispatch): job $PHASE_NUM parked on pause"; then
      state="job $PHASE_NUM's uncommitted work is parked as a WIP commit on branch $branch; $main_branch is untouched at $head"
    else
      state="job $PHASE_NUM's uncommitted work could not be parked; the tree is left as it stands"
    fi
    git -C "$REPO" checkout -q "$main_branch" 2>/dev/null
  else
    state="job $PHASE_NUM left no uncommitted work; $main_branch remains at $head"
  fi
  print -r -- "$state"
}

# SIGUSR1 is reserved for `dispatch pause`. The signal handler only leaves a
# durable request: zsh may run a trap in the interrupted wait's context, where
# child ownership and variable updates are not safe to carry back. The normal
# runner flow owns build shutdown, verifier settlement, parking, the PAUSED
# journal boundary, and the watchdog event. A verifier is a correctness
# boundary: pause waits for its own bounded turn to finish and records the
# verdict instead of killing it.
pause_chain() {
  [[ $PAUSING -eq 0 ]] || return 0
  PAUSING=1
  trap - USR1
  rm -f "$PAUSE_REQUEST"
  stop_stage_for_pause "$BUILD_PID"
  BUILD_PID=""
  if [[ -n "$VERIFY_PID" ]]; then
    journal "verify $VERIFY_NUM/$TOTAL" "pause-wait" "pause requested; waiting for the verifier's verdict"
    reconcile_verify
  fi
  local state
  state=$(park_paused_work)
  journal "phase $PHASE_NUM/$TOTAL" "PAUSED" "$state"
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body paused "$PHASE_NUM" "$(print -rn -- "$state" | json_string)")" 80
  exit 0
}
TRAPUSR1() { : > "$PAUSE_REQUEST"; }
honor_pause_request() { [[ -f "$PAUSE_REQUEST" ]] && pause_chain; }

# Restores the paused WIP without creating a commit on the main branch. The
# resumed worker receives the same dirty tree the interrupted worker left.
restore_paused_work() {
  local branch="dispatch/$SLUG/job$RESUME_FROM-paused"
  git -C "$REPO" show-ref --verify --quiet "refs/heads/$branch" || return 0
  if ! git -C "$REPO" cherry-pick --no-commit "$branch"; then
    journal "phase $RESUME_FROM/$TOTAL" "FAILED" "could not restore paused work from $branch"
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body failed "$RESUME_FROM" "$(print -rn -- "Resume could not restore paused work from $branch." | json_string)")" 80
    exit 1
  fi
  journal "phase $RESUME_FROM/$TOTAL" "restore" "paused work restored from $branch"
}

verify_wanted() { ! grep -qiE '<!--[[:space:]]*verify:[[:space:]]*no' "$1" 2>/dev/null; }

# Newest implementation commit in a unit range. Planner-owned docs commits
# may move shared HEAD but never satisfy the build gate or become attribution.
newest_non_docs_commit() {
  git -C "$REPO" log --format=$'%H\t%s' "$1..$2" 2>/dev/null \
    | while IFS=$'\t' read -r hash subject; do
        [[ "$subject" == docs\(* ]] || { print -r -- "$hash"; break; }
      done
}

# Mechanical verifier pre-check. Git already omits ignored files. The chain's
# prompt files and referenced punch list are its own mutable coordination
# files; any untracked .dispatch artifact is harmless runner scaffolding.
verify_precheck_reason() {
  python3 - "$REPO" "$VERIFY_BASE_COMMIT" "$VERIFY_COMMIT" "$SLUG" "${PHASE_FILES[@]}" <<'PYEOF'
import os, pathlib, re, subprocess, sys

repo, base, head, slug, *phase_files = sys.argv[1:]
allowed = set()
for filename in phase_files:
    candidate = pathlib.Path(filename)
    try:
        relative = candidate.resolve().relative_to(pathlib.Path(repo).resolve()).as_posix()
    except (OSError, ValueError):
        continue
    allowed.add(relative)
    try:
        prompt = candidate.read_text(encoding='utf-8', errors='replace')
    except OSError:
        continue
    for punchlist in re.findall(r'\b(PUNCHLIST_[\w.-]+\.md)\b', prompt):
        allowed.add(punchlist)

status = subprocess.run(
    ['git', '-C', repo, 'status', '--porcelain=v1', '-z', '--untracked-files=all'],
    check=False, capture_output=True,
).stdout.decode('utf-8', errors='replace').split('\0')
dirty = []
index = 0
while index < len(status):
    record = status[index]
    index += 1
    if not record:
        continue
    code, filename = record[:2], record[3:]
    if 'R' in code or 'C' in code:
        index += 1
    if filename in allowed:
        continue
    if code == '??' and filename.startswith('.dispatch/'):
        continue
    dirty.append(f'{code} {filename}')
if dirty:
    print('working tree has paths outside this chain: ' + ', '.join(dirty[:4]))
    raise SystemExit(0)

subjects = subprocess.run(
    ['git', '-C', repo, 'log', '--format=%s', f'{base}..{head}'],
    check=False, capture_output=True, text=True,
).stdout.splitlines()
if not any(not subject.startswith('docs(') for subject in subjects):
    print(f'commit range {base}..{head} contains no non-docs commit')
PYEOF
}

# Extracts only the named job section from the committed punch list. The
# builder's operational prompt never enters verifier context.
write_verify_section() {
  python3 - "$VERIFY_FILE" "$REPO" "$VERIFY_COMMIT" <<'PYEOF'
import pathlib, re, subprocess, sys

prompt_file, repo, commit = sys.argv[1:]
prompt = pathlib.Path(prompt_file).read_text(encoding='utf-8', errors='replace')
reference = re.search(r'\b(?:Job|Phase)\s+(\d+)\s+of\s+(PUNCHLIST_[\w.-]+\.md)\b', prompt, re.I)
if not reference:
    print('(No named punch-list section was present in the unit prompt.)')
    raise SystemExit(0)
unit, filename = int(reference.group(1)), reference.group(2)
content = subprocess.run(
    ['git', '-C', repo, 'show', f'{commit}:{filename}'],
    check=False, capture_output=True, text=True,
)
if content.returncode:
    print(f'(The committed {filename} section for job {unit} could not be read.)')
    raise SystemExit(0)
lines = content.stdout.splitlines()
heading = re.compile(rf'^(#{{1,6}})\s+(?:Job|Phase)\s+{unit}(?:\D|$)', re.I)
start = next((i for i, line in enumerate(lines) if heading.match(line)), None)
if start is None:
    print(f'(Job {unit} was not found in committed {filename}.)')
    raise SystemExit(0)
level = len(heading.match(lines[start]).group(1))
end = len(lines)
for index in range(start + 1, len(lines)):
    next_heading = re.match(r'^(#{1,6})\s+', lines[index])
    if next_heading and len(next_heading.group(1)) <= level:
        end = index
        break
print('\n'.join(lines[start:end]).rstrip())
PYEOF
}

# The verifier sees identity, the exact done-check section, the immutable
# commit range and stat, and environment constraints. It never receives the
# builder's whole phase prompt.
write_verify_prompt() {
  local out="$JOURNAL_DIR/verify$VERIFY_NUM.prompt.md"
  {
    print -r -- "<!-- name: Verify: $VERIFY_NAME -->"
    print -r -- "You are the fresh-context verifier for job $VERIFY_NUM of $TOTAL ($VERIFY_NAME) in $REPO. The builder's attributed commit is $VERIFY_COMMIT ($VERIFY_SUBJECT)."
    print -r -- ""
    print -r -- "Punch-list section and done check:"
    write_verify_section
    print -r -- ""
    print -r -- "Commit range: $VERIFY_BASE_COMMIT..$VERIFY_COMMIT"
    git -C "$REPO" diff --stat "$VERIFY_BASE_COMMIT..$VERIFY_COMMIT"
    print -r -- ""
    print -r -- "Constraints: inspect only the committed tree with git show/diff; do not edit, commit, stash, reset, push, or change punch-list checks. Run the section's done check and report concrete evidence. Dev is port 4748 with config ~/.claude-dev, DB ~/.cloudcli-dev/auth.db, and public URL https://spoton-worker.tail6e1056.ts.net:8443. Treat ignored files, this chain's punch list and .dispatch files, and untracked .dispatch files as allowed tree state."
    print -r -- ""
    print -r -- "Use FAIL only for an observed defect. If login, tooling, or the environment prevented a check, do not call that a defect: list what you could not exercise and use INCONCLUSIVE. Your last line must be exactly one of: VERIFY: PASS, VERIFY: INCONCLUSIVE: <one-line list of what could not be exercised>, or VERIFY: FAIL: <one-line observed defect>."
  } > "$out"
  print -r -- "$out"
}

# Launches the verify stage for the unit whose build just committed, in the
# background; the caller goes straight on to the next build. A Codex
# verifier is announced once its thread id shows in the log.
start_verify() {
  local prompt session log="$JOURNAL_DIR/verify$VERIFY_NUM.log"
  prompt=$(write_verify_prompt)
  session=$(uuidgen | tr '[:upper:]' '[:lower:]')
  if [[ "$VERIFY_ENGINE" == "claude" ]]; then
    announce_session "$session" "$VERIFY_COMMIT" "$VERIFY_NUM" verify claude "$VERIFY_MODEL" "Verify: $VERIFY_NAME"
  fi
  local permission_detail=""
  [[ "$VERIFY_ENGINE" == "claude" ]] && permission_detail=", permission $CLAUDE_PERMISSION_MODE"
  journal "verify $VERIFY_NUM/$TOTAL" "start" "$VERIFY_NAME against $VERIFY_COMMIT ($VERIFY_ENGINE $VERIFY_MODEL$permission_detail)"
  api_post "/api/watchdog/chains/$SLUG/events" "$(event_body verify-start $VERIFY_NUM '')" 3
  VERIFY_DEADLINE=$(($(date +%s) + VERIFY_CAP_SECS))
  rmdir "$VERIFY_HOLD_REPORTED" 2>/dev/null || true
  print -r -- "$VERIFY_DEADLINE" > "$VERIFY_HOLD_FILE"
  : > "$log"
  # Verify is a billing and correctness boundary: it is always standard tier,
  # regardless of the chain preference read by the next build.
  run_engine "$VERIFY_ENGINE" "$prompt" "$log" "$session" "$VERIFY_MODEL" "$VERIFY_EFFORT" 0 verify &
  VERIFY_PID=$!
  if [[ "$VERIFY_ENGINE" == "codex" ]]; then
    VERIFY_THREAD=$(wait_thread_id "$log" "$VERIFY_PID")
    if [[ -n "$VERIFY_THREAD" ]]; then
      announce_session "$VERIFY_THREAD" "$VERIFY_COMMIT" "$VERIFY_NUM" verify codex "$VERIFY_MODEL" "Verify: $VERIFY_NAME"
    else
      journal "verify $VERIFY_NUM/$TOTAL" "announce" "codex reported no thread id; the verifier's rollout stays unlinked"
    fi
  fi
}

# Reads a finished verifier's verdict off its log. PASS and INCONCLUSIVE clear
# the stage (the latter with a journal note and recovery notification); a
# limit exit without a verdict marks the stage for a re-run once no build is
# in flight (reconcile_verify); an explicit FAIL is recorded and clears the
# stage without disturbing the build already in flight.
settle_verify() {
  local forced_reason="${1:-}" rc=0 log="$JOURNAL_DIR/verify$VERIFY_NUM.log" verdict verdict_source
  # Every wait path owns the same 20-minute ceiling. A pause or terminal
  # reconcile therefore cannot wait forever, and the dev-command hold always
  # releases from this one settlement point.
  if [[ -n "$forced_reason" ]]; then
    journal "verify $VERIFY_NUM/$TOTAL" "cap" "verify cap reached after ${VERIFY_CAP_SECS}s; recording INCONCLUSIVE"
    stop_stage_for_pause "$VERIFY_PID"
    rc=124
  else
    while kill -0 "$VERIFY_PID" 2>/dev/null; do
      if [[ $(date +%s) -ge $VERIFY_DEADLINE ]]; then
        forced_reason="verify cap"
        journal "verify $VERIFY_NUM/$TOTAL" "cap" "verify cap reached after ${VERIFY_CAP_SECS}s; recording INCONCLUSIVE"
        stop_stage_for_pause "$VERIFY_PID"
        rc=124
        break
      fi
      sleep 1
    done
  fi
  if [[ -z "$forced_reason" ]]; then
    # A pause signal can interrupt zsh's wait. Retry until this exact child is
    # reaped rather than interpreting the interrupted wait as its real exit.
    while true; do
      wait $VERIFY_PID
      rc=$?
      kill -0 "$VERIFY_PID" 2>/dev/null || break
    done
  fi
  VERIFY_PID=""
  rm -f "$VERIFY_HOLD_FILE"
  rmdir "$VERIFY_HOLD_REPORTED" 2>/dev/null || true
  VERIFY_DEADLINE=0
  # Codex writes its final assistant message to .last; Claude's verdict stays
  # in the session log. The verdict is the last VERIFY: line, wherever markdown wrapped it
  # (`**VERIFY: PASS**`, a backticked or indented line all count).
  verdict_source="$log"
  [[ "$VERIFY_ENGINE" == "codex" ]] && verdict_source="$log.last"
  verdict=$(grep -oE 'VERIFY: (PASS|INCONCLUSIVE[^`*]*|FAIL[^`*]*)' "$verdict_source" 2>/dev/null | tail -1 | sed 's/[[:space:]]*$//')
  [[ -z "$forced_reason" ]] || verdict="VERIFY: INCONCLUSIVE: $forced_reason"
  if [[ "$VERIFY_ENGINE" == "claude" && $rc -ne 0 && -z "$verdict" ]] && grep -qiE "$LIMIT_PATTERN" "$log"; then
    journal "verify $VERIFY_NUM/$TOTAL" "limit" "verifier exited $rc on the session limit; re-running once the build in flight has recovered"
    VERIFY_RETRY=1
    return 0
  fi
  if [[ "$VERIFY_ENGINE" == "codex" && $rc -ne 0 && -z "$verdict" ]] && grep -qiE "$CODEX_LIMIT_PATTERN" "$log"; then
    journal "verify $VERIFY_NUM/$TOTAL" "limit" "verifier exited $rc on the codex usage limit; re-running once the build in flight has finished"
    VERIFY_RETRY=1
    return 0
  fi
  if [[ "$verdict" == "VERIFY: PASS"* ]]; then
    journal "verify $VERIFY_NUM/$TOTAL" "end" "PASS for $VERIFY_COMMIT"
    api_post "/api/watchdog/chains/$SLUG/events" "$(event_body verify-end $VERIFY_NUM '' '' '' PASS)" 3
    VERIFY_NUM=0
    return 0
  fi
  if [[ "$verdict" != "VERIFY: FAIL"* ]]; then
    [[ -n "$verdict" ]] || verdict="VERIFY: INCONCLUSIVE: verifier exited $rc without a verdict (verify$VERIFY_NUM.log)"
    local note="${verdict#VERIFY: INCONCLUSIVE: }"
    journal "verify $VERIFY_NUM/$TOTAL" "end" "INCONCLUSIVE for $VERIFY_COMMIT: $note; continuing chain"
    VERIFY_INCONCLUSIVE_COUNT=$((VERIFY_INCONCLUSIVE_COUNT + 1))
    api_post "/api/watchdog/notify" "$(python3 - "$SLUG" "$VERIFY_NUM" "$TOTAL" "$VERIFY_NAME" "$VERIFY_COMMIT" "$note" <<'PYEOF'
import json, sys
slug, phase, total, name, commit_hash, note = sys.argv[1:7]
print(json.dumps({
    'kind': 'recovery',
    'title': f'Chain {slug} verify was inconclusive',
    'body': f'Job {phase} of {total} ({name}) could not be fully verified at {commit_hash}: {note}. The chain is continuing.',
}))
PYEOF
)" 3
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body verify-end $VERIFY_NUM "$(print -rn -- "$note" | json_string)" '' '' INCONCLUSIVE)" 3
    VERIFY_NUM=0
    return 0
  fi
  record_verify_failure "$verdict"
}

# A failed verify is a repair signal, not a chain boundary. Record the exact
# reason and resume point on the committed unit, then let the current build
# and every queued unit continue unchanged.
record_verify_failure() {
  local reason="$1" resume
  journal "verify $VERIFY_NUM/$TOTAL" "FAILED" "$reason"
  resume="Job $VERIFY_NUM ($VERIFY_NAME) failed verify at commit $VERIFY_COMMIT: ${reason#VERIFY: FAIL: }. Resume point: append a fix unit for job $VERIFY_NUM from $VERIFY_COMMIT; verifier log: $JOURNAL_DIR/verify$VERIFY_NUM.log."
  VERIFY_FAILURES+=("$resume")
  save_resume_state "$((PHASE_NUM + 1))"
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body verify-end $VERIFY_NUM "$(print -rn -- "$resume" | json_string)" '' '' FAIL)" 80
  VERIFY_NUM=0
}

# Blocks until the in-flight verify (if any) has settled, re-running it after
# a limit exit now that no build is in flight; a FAIL is recorded and clears.
reconcile_verify() {
  while true; do
    if [[ -n "$VERIFY_PID" ]]; then
      settle_verify
    fi
    if [[ $VERIFY_RETRY -eq 1 ]]; then
      VERIFY_RETRY=0
      if [[ "$VERIFY_ENGINE" == "codex" ]]; then
        wait_codex_limit "verify $VERIFY_NUM/$TOTAL" "$VERIFY_NUM" "$VERIFY_NAME" verify "${VERIFY_THREAD:-}"
      else
        recover_from_limit "verify $VERIFY_NUM/$TOTAL" "$VERIFY_NUM" "$VERIFY_NAME" "$JOURNAL_DIR/verify$VERIFY_NUM.log" verify
      fi
      journal "verify $VERIFY_NUM/$TOTAL" "retry" "re-running the verify of $VERIFY_NAME after limit recovery"
      start_verify
      continue
    fi
    break
  done
}

# A promote hold is honored only between units. The just-committed unit's
# verifier settles first, resume state points at the next uncommitted unit,
# and no worktree parking is needed because the commit gate left it clean.
honor_promote_hold() {
  local reason
  reason=$(read_chain_hold_reason)
  [[ "$reason" == "promote" ]] || return 0
  reconcile_verify
  save_resume_state "$((PHASE_NUM + 1))"
  journal run HELD promote
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body held "$PHASE_NUM" '"promote"')" 80
  exit 0
}

# Waits for the build in flight, settling the verify the moment it exits so
# a FAIL kills the build within seconds instead of after it finishes.
watch_build() {
  local elapsed turns
  while kill -0 $BUILD_PID 2>/dev/null; do
    [[ -f "$PAUSE_REQUEST" ]] && return 0
    elapsed=$(($(date +%s) - UNIT_STARTED_AT))
    turns=$(model_turn_count "$UNIT_ENGINE" "$SESSION_ID" "${BUILD_THREAD:-}")
    UNIT_MODEL_TURNS="$turns"
    if [[ $turns -gt $UNIT_MODEL_TURN_BUDGET ]]; then
      UNIT_BUDGET_REASON="passed the $UNIT_MODEL_TURN_BUDGET model-turn budget (observed $turns turns)"
      stop_stage_for_pause "$BUILD_PID"
      return 124
    fi
    if [[ $elapsed -ge $UNIT_WALL_TIME_BUDGET_SECS ]]; then
      UNIT_BUDGET_REASON="reached the ${UNIT_WALL_TIME_BUDGET_SECS}s wall-time budget (observed ${elapsed}s)"
      stop_stage_for_pause "$BUILD_PID"
      return 124
    fi
    if [[ -n "$VERIFY_PID" ]]; then
      if ! kill -0 $VERIFY_PID 2>/dev/null; then
        settle_verify
      elif [[ $(date +%s) -ge $VERIFY_DEADLINE ]]; then
        settle_verify "verify cap"
      fi
    fi
    sleep 1
  done
  wait $BUILD_PID
}

# The planner-supplied phase manifest (ui9 B4) rides along in the chain
# registration; the watchdog stores it and the phase navigator renders it.
MANIFEST_PATH="${DISPATCH_MANIFEST:-}"

journal run "$([[ $RESUME_FROM -gt 1 ]] && print resume || print start)" "chain $SLUG in $REPO from job $RESUME_FROM ($TOTAL phases; default engine $CHAIN_ENGINE, verify on $VERIFY_ENGINE $VERIFY_MODEL)"
[[ -x "$CSWAP_BIN" ]] && unpark_stale
if [[ $RESUME_FROM -eq 1 && -z "${DISPATCH_RESUMING:-}" ]]; then
  api_post "/api/watchdog/chains" "$(python3 - "$SLUG" "$REPO" "$TOTAL" "$MANIFEST_PATH" "${DISPATCHING_SESSION_ID:-}" <<'PYEOF'
import json, sys
slug, repo, total, manifest_path, dispatching_session_id = sys.argv[1:6]
body = {'slug': slug, 'projectPath': repo, 'phases': int(total)}
if dispatching_session_id:
    body['dispatchingSessionId'] = dispatching_session_id
if manifest_path:
    try:
        body['manifest'] = json.load(open(manifest_path))
    except Exception:
        pass
print(json.dumps(body))
PYEOF
)" 3
else
  restore_paused_work
fi

# Append queue (ui9 B4): `dispatch append` drops prompt files here; they are
# picked up after each phase's commit gate and run as additional units.
CONSUMED_DIR="$APPEND_DIR/consumed"
pickup_appends() {
  local f
  for f in "$APPEND_DIR"/*.md(N); do
    mkdir -p "$CONSUMED_DIR"
    mv "$f" "$CONSUMED_DIR/${f:t}"
    PHASE_FILES+=("$CONSUMED_DIR/${f:t}")
    journal append "queued" "${f:t} picked up as unit ${#PHASE_FILES[@]}"
  done
  TOTAL=${#PHASE_FILES[@]}
  save_resume_state "$((PHASE_NUM + 1))"
}

# zsh continues reading the inode it opened at spawn, so an on-disk runner
# fix cannot affect a live chain without an explicit boundary exec. A reload
# waits for the just-started verifier, persists its verdict and all prompt
# state through resume.json, then replaces this process before the next unit.
reload_runner_if_changed() {
  [[ $PHASE_NUM -lt ${#PHASE_FILES[@]} ]] || return 0
  local disk_hash next_phase
  disk_hash=$(/usr/bin/shasum -a 256 "$RUNNER_PATH" | awk '{print $1}')
  [[ "$disk_hash" == "$RUNNER_START_HASH" ]] && return 0
  reconcile_verify
  honor_pause_request
  next_phase=$((PHASE_NUM + 1))
  disk_hash=$(/usr/bin/shasum -a 256 "$RUNNER_PATH" | awk '{print $1}')
  save_resume_state "$next_phase"
  journal run reload "runner reloaded at $disk_hash"
  rm -f "$HEADER_FILE"
  exec env \
    DISPATCH_RESUME_FROM="$next_phase" \
    DISPATCH_RESUMING=1 \
    DISPATCH_RELOADING=1 \
    "$RUNNER_PATH" "$REPO" "$SLUG" "${PHASE_FILES[@]}"
}

while [[ $PHASE_NUM -lt ${#PHASE_FILES[@]} ]]; do
  honor_pause_request
  honor_promote_hold
  PHASE_NUM=$((PHASE_NUM + 1))
  PHASE_FILE="${PHASE_FILES[$PHASE_NUM]}"
  PHASE_NAME=$(basename "$PHASE_FILE")
  # The unit's title is the prompt file's name header (codex job 5); a file
  # without one falls back to its stem, never to the prompt text.
  UNIT_NAME=$(header_value "$PHASE_FILE" name)
  [[ -z "$UNIT_NAME" ]] && UNIT_NAME="${PHASE_NAME:r}"
  if ! reset_superseded_job "$PHASE_FILE"; then
    journal "phase $PHASE_NUM/$TOTAL" "STOPPED" "could not reset the superseded punch-list job before $PHASE_NAME"
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body stopped $PHASE_NUM "$(print -rn -- "Job $PHASE_NUM ($PHASE_NAME) could not reset its superseded punch-list section." | json_string)")" 80
    exit 74
  fi
  BASE_COMMIT=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo none)

  if grep -q '<!-- browser -->' "$PHASE_FILE" 2>/dev/null; then
    wait_for_chrome_slot
  fi

  unit_settings "$PHASE_FILE"
  if [[ -z "$UNIT_BIN" ]]; then
    reconcile_verify
    journal "phase $PHASE_NUM/$TOTAL" "FAILED" "$PHASE_NAME needs the $UNIT_ENGINE CLI, which is not on PATH; stopping chain"
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body failed $PHASE_NUM "$(print -rn -- "Phase $PHASE_NUM ($PHASE_NAME) needs the $UNIT_ENGINE CLI, which is not on PATH." | json_string)")" 80
    exit 1
  fi
  UNIT_FAST_MODE=0
  if [[ "$UNIT_ENGINE" == "codex" ]]; then
    UNIT_FAST_MODE=$(read_chain_fast_mode)
  fi
  FAST_JOURNAL=""
  [[ "$UNIT_FAST_MODE" == "1" ]] && FAST_JOURNAL=", fast"
  PERMISSION_JOURNAL=""
  [[ "$UNIT_ENGINE" == "claude" ]] && PERMISSION_JOURNAL=", permission $CLAUDE_PERMISSION_MODE"
  journal "phase $PHASE_NUM/$TOTAL" "start" "$PHASE_NAME ($UNIT_ENGINE $UNIT_MODEL, effort $UNIT_EFFORT$FAST_JOURNAL$PERMISSION_JOURNAL)"
  api_post "/api/watchdog/chains/$SLUG/events" "$(event_body phase-start $PHASE_NUM '')" 3

  SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
  if [[ "$UNIT_ENGINE" == "claude" ]]; then
    announce_session "$SESSION_ID" "$BASE_COMMIT" "$PHASE_NUM" build claude "$UNIT_MODEL" "$UNIT_NAME"
  fi

  # The build stage: a fresh headless session in the repo, run in the
  # background so the previous unit's verify can be settled while it works.
  : > "$JOURNAL_DIR/phase$PHASE_NUM.log"
  UNIT_STARTED_AT=$(date +%s)
  UNIT_BUDGET_REASON=""
  UNIT_MODEL_TURNS=0
  run_engine "$UNIT_ENGINE" "$PHASE_FILE" "$JOURNAL_DIR/phase$PHASE_NUM.log" "$SESSION_ID" "$UNIT_MODEL" "$UNIT_EFFORT" "$UNIT_FAST_MODE" build &
  BUILD_PID=$!
  BUILD_THREAD=""
  if [[ "$UNIT_ENGINE" == "codex" ]]; then
    BUILD_THREAD=$(wait_thread_id "$JOURNAL_DIR/phase$PHASE_NUM.log" "$BUILD_PID")
    if [[ -n "$BUILD_THREAD" ]]; then
      announce_session "$BUILD_THREAD" "$BASE_COMMIT" "$PHASE_NUM" build codex "$UNIT_MODEL" "$UNIT_NAME"
    else
      journal "phase $PHASE_NUM/$TOTAL" "announce" "codex reported no thread id; the unit's rollout stays unlinked"
    fi
  fi
  watch_build
  RC=$?
  honor_pause_request
  BUILD_PID=""

  if [[ -n "$UNIT_BUDGET_REASON" ]]; then
    reconcile_verify
    report_claude_read_usage
    journal "phase $PHASE_NUM/$TOTAL" "STOPPED" "$PHASE_NAME $UNIT_BUDGET_REASON; decision-needed sent"
    api_post "/api/watchdog/notify" "$(python3 - "$SLUG" "$PHASE_NUM" "$TOTAL" "$PHASE_NAME" "$UNIT_BUDGET_REASON" <<'PYEOF'
import json, sys
slug, phase, total, name, reason = sys.argv[1:6]
print(json.dumps({
    'kind': 'decision-needed',
    'title': f'Chain {slug} stopped on a unit budget',
    'body': f'Job {phase} of {total} ({name}) {reason}. The chain stopped like a commit-gate miss, with work left in place for a decision.',
}))
PYEOF
)" 3
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body stopped "$PHASE_NUM" "$(print -rn -- "Job $PHASE_NUM ($PHASE_NAME) $UNIT_BUDGET_REASON." | json_string)")" 80
    exit 2
  fi

  if [[ "$UNIT_ENGINE" == "codex" && "$UNIT_FAST_MODE" == "1" && $RC -eq 0 ]]; then
    if confirm_fast_rollout "$JOURNAL_DIR/phase$PHASE_NUM.log" "$BUILD_THREAD"; then
      journal "phase $PHASE_NUM/$TOTAL" "fast-confirmed" "rollout $BUILD_THREAD started after accepting service_tier=fast"
    else
      journal "phase $PHASE_NUM/$TOTAL" "FAILED" "fast tier was requested but the unit rollout did not confirm a started thread"
      RC=70
    fi
  fi

  NEW_COMMIT=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo none)

  # Limit-exit: recover (switch or wait) and retry the phase instead of
  # tripping the commit gate.
  if [[ "$UNIT_ENGINE" == "claude" && $RC -ne 0 ]] && grep -qiE "$LIMIT_PATTERN" "$JOURNAL_DIR/phase$PHASE_NUM.log"; then
    recover_from_limit "phase $PHASE_NUM/$TOTAL" "$PHASE_NUM" "$PHASE_NAME" "$JOURNAL_DIR/phase$PHASE_NUM.log"
    journal "phase $PHASE_NUM/$TOTAL" "retry" "re-running $PHASE_NAME after limit recovery"
    PHASE_NUM=$((PHASE_NUM - 1))
    continue
  fi
  # A Codex usage limit is a wait, never a defect: the unit re-runs on the
  # uncommitted tree after the reset (codex job 2).
  if [[ "$UNIT_ENGINE" == "codex" && $RC -ne 0 ]] && grep -qiE "$CODEX_LIMIT_PATTERN" "$JOURNAL_DIR/phase$PHASE_NUM.log"; then
    wait_codex_limit "phase $PHASE_NUM/$TOTAL" "$PHASE_NUM" "$PHASE_NAME" build "$BUILD_THREAD"
    journal "phase $PHASE_NUM/$TOTAL" "retry" "re-running $PHASE_NAME after the codex limit wait"
    PHASE_NUM=$((PHASE_NUM - 1))
    continue
  fi
  report_claude_read_usage
  LIMIT_STREAK=0
  LIMIT_STREAK_KEY=""
  WAIT_CYCLES=0
  WAIT_TOTAL=0
  PARK_ESCALATED=0

  # The commit is the build boundary. Shared HEAD movement counts only when
  # BASE..HEAD contains implementation work; planner docs commits cannot pass
  # the gate or become this unit's recorded commit.
  [[ $RC -eq 0 ]] || journal "phase $PHASE_NUM/$TOTAL" "build-exit" "$UNIT_ENGINE exited $RC; checking the commit gate"
  UNIT_COMMIT=$(newest_non_docs_commit "$BASE_COMMIT" "$NEW_COMMIT")
  if [[ -z "$UNIT_COMMIT" ]]; then
    reconcile_verify
    if verify_wanted "$PHASE_FILE"; then
      PRECHECK_REASON="commit range $BASE_COMMIT..$NEW_COMMIT contains no non-docs commit"
      journal "verify $PHASE_NUM/$TOTAL" "pre-check" "INCONCLUSIVE: $PRECHECK_REASON; model verify skipped"
      VERIFY_INCONCLUSIVE_COUNT=$((VERIFY_INCONCLUSIVE_COUNT + 1))
      api_post "/api/watchdog/chains/$SLUG/events" \
        "$(event_body verify-end $PHASE_NUM "$(print -rn -- "$PRECHECK_REASON" | json_string)" '' '' INCONCLUSIVE)" 3
    fi
    if [[ "$UNIT_ENGINE" == "codex" ]]; then
      LOG_TAIL=$(head -c 300 "$JOURNAL_DIR/phase$PHASE_NUM.log.last" 2>/dev/null | tr '\n' ' ')
      journal "phase $PHASE_NUM/$TOTAL" "STOPPED" "commit gate: BASE..HEAD has no non-docs commit after $PHASE_NAME (exit $RC); last message: ${LOG_TAIL:-none}"
    else
      journal "phase $PHASE_NUM/$TOTAL" "STOPPED" "commit gate: BASE..HEAD has no non-docs commit after $PHASE_NAME (exit $RC)"
    fi
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body stopped $PHASE_NUM "$(print -rn -- "Commit gate stopped the chain: phase $PHASE_NUM ($PHASE_NAME) produced no non-docs commit." | json_string)")" 80
    exit 2
  fi

  UNIT_COMMIT_SHORT=$(git -C "$REPO" show -s --format=%h "$UNIT_COMMIT")
  UNIT_SUBJECT=$(git -C "$REPO" show -s --format=%s "$UNIT_COMMIT")
  journal "phase $PHASE_NUM/$TOTAL" "end" "$UNIT_COMMIT_SHORT $UNIT_SUBJECT"
  # The phase-end event carries the job's commit (ui13 job 14) so the jobs
  # view can show what each job shipped.
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body phase-end $PHASE_NUM '' "$UNIT_COMMIT_SHORT" "$UNIT_SUBJECT")" 3

  # The previous unit's verify must have passed before this unit's starts:
  # at most one verify is in flight, one build behind it.
  reconcile_verify
  honor_pause_request
  if verify_wanted "$PHASE_FILE"; then
    VERIFY_NUM=$PHASE_NUM
    VERIFY_NAME="$UNIT_NAME"
    VERIFY_FILE="$PHASE_FILE"
    VERIFY_BASE_COMMIT="$BASE_COMMIT"
    VERIFY_COMMIT="$UNIT_COMMIT_SHORT"
    VERIFY_SUBJECT="$UNIT_SUBJECT"
    PRECHECK_REASON=$(verify_precheck_reason)
    if [[ -n "$PRECHECK_REASON" ]]; then
      journal "verify $VERIFY_NUM/$TOTAL" "pre-check" "INCONCLUSIVE: $PRECHECK_REASON; model verify skipped"
      VERIFY_INCONCLUSIVE_COUNT=$((VERIFY_INCONCLUSIVE_COUNT + 1))
      api_post "/api/watchdog/chains/$SLUG/events" \
        "$(event_body verify-end $VERIFY_NUM "$(print -rn -- "$PRECHECK_REASON" | json_string)" '' '' INCONCLUSIVE)" 3
      VERIFY_NUM=0
    else
      start_verify
    fi
  fi
  pickup_appends
  honor_promote_hold
  reload_runner_if_changed
done

reconcile_verify
honor_pause_request
honor_promote_hold
VERIFY_FAILURE_COUNT=${#VERIFY_FAILURES[@]}
TAIL=$(git -C "$REPO" log --oneline "$CHAIN_BASE"..HEAD 2>/dev/null | head -20 | json_string)
if [[ $VERIFY_FAILURE_COUNT -gt 0 && $VERIFY_INCONCLUSIVE_COUNT -eq 0 ]]; then
  VERIFY_FAILURE_NOUN="$([[ $VERIFY_FAILURE_COUNT -eq 1 ]] && print failure || print failures)"
  journal run "end" "all $TOTAL phases committed; completed with $VERIFY_FAILURE_COUNT verify $VERIFY_FAILURE_NOUN"
elif [[ $VERIFY_FAILURE_COUNT -gt 0 || $VERIFY_INCONCLUSIVE_COUNT -gt 0 ]]; then
  journal run "end" "all $TOTAL phases committed; verify totals include $VERIFY_FAILURE_COUNT failed and $VERIFY_INCONCLUSIVE_COUNT inconclusive"
else
  journal run "end" "all $TOTAL phases committed and verified"
fi
api_post "/api/watchdog/chains/$SLUG/events" "$(event_body completed $TOTAL "$TAIL")" 80
if [[ $VERIFY_FAILURE_COUNT -gt 0 && $VERIFY_INCONCLUSIVE_COUNT -eq 0 ]]; then
  print -r -- "dispatch: chain $SLUG completed with $VERIFY_FAILURE_COUNT verify $VERIFY_FAILURE_NOUN ($TOTAL phases)"
elif [[ $VERIFY_FAILURE_COUNT -gt 0 || $VERIFY_INCONCLUSIVE_COUNT -gt 0 ]]; then
  print -r -- "dispatch: chain $SLUG completed with $VERIFY_FAILURE_COUNT failed and $VERIFY_INCONCLUSIVE_COUNT inconclusive verifies ($TOTAL phases)"
else
  print -r -- "dispatch: chain $SLUG completed ($TOTAL phases)"
fi
