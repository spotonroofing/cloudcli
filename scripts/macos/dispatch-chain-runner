#!/bin/zsh
# dispatch-chain-runner — the out-of-process chain executor behind `dispatch`.
#
#   dispatch-chain-runner <repo> <slug> <phase-file ...>
#
# Spawned fully detached (own session) by the dispatch CLI, so a CloudCLI
# server restart or promote mid-chain never touches a running chain. Each
# phase runs as a fresh headless session in the repo — `claude -p` or
# `codex exec`, per unit (codex job 2) — with the same commit gate, journal
# lines, and watchdog boundary events. Claude transcripts land in
# ~/.claude/projects, Codex rollouts in ~/.codex/sessions; both surface in
# the worker pane through the session synchronizers.
#
# Per-unit engine (codex job 2): a prompt file may carry `<!-- engine:
# claude|codex -->`, `<!-- model: <id> -->` and `<!-- effort: <level> -->`
# in its header; each overrides the chain's DISPATCH_ENGINE / DISPATCH_MODEL
# / DISPATCH_EFFORT for that unit only, and a missing header falls back to
# the env, then the engine default (Claude: claude-fable-5 at high with the
# claude-opus-4-8 capacity fallback; Codex: gpt-5.6-sol at high).
#
# Pipelined verification (ui14 job 10): every unit is two stages. The build
# stage is the phase prompt itself, ending at the commit gate. The verify
# stage is a second fresh-context session — Codex gpt-5.6-luna at high
# whatever the build's engine (codex job 2; DISPATCH_VERIFY_ENGINE and
# DISPATCH_VERIFY_MODEL exist only so stub chains and tests can pin it) —
# that checks the committed job against its done check and answers
# `VERIFY: PASS` or `VERIFY: FAIL: <reason>` on its last line; it runs in
# the background while the next unit's build starts, so the verify tail
# leaves the critical path.
# A phase file that carries `<!-- verify: no -->` in its header skips its
# verify stage. A failing verify rewinds: the in-flight build is killed, its
# work is parked as a WIP commit on a branch (main is never rewritten), and
# the terminal verify-failed event carries the exact resume point.
#
# Watchdog events carry projectPath and phases so a server that restarted
# mid-chain (and lost its in-memory chain registry) re-registers the chain
# from the event itself; terminal events (completed/stopped/failed) retry
# for the better part of an hour so the chain-end planner wake is never lost.
set -u

SERVER_URL="${DISPATCH_SERVER_URL:-http://127.0.0.1:4747}"
DB_PATH="${DISPATCH_DB_PATH:-$HOME/.cloudcli/auth.db}"

[[ $# -ge 3 ]] || { print -u2 "usage: dispatch-chain-runner <repo> <slug> <phase-file ...>"; exit 64; }
REPO="$1"; SLUG="$2"; shift 2
typeset -a PHASE_FILES
PHASE_FILES=("$@")

cd "$REPO" || { print -u2 "dispatch-chain-runner: cannot cd to $REPO"; exit 66; }

# Chain-level engine/model/effort from the env: the fallback for units whose
# header names none. DISPATCH_MODEL applies only to units on the chain's
# engine (a Claude model id means nothing to a Codex unit and vice versa).
CHAIN_ENGINE="${DISPATCH_ENGINE:-claude}"
[[ "$CHAIN_ENGINE" == "claude" || "$CHAIN_ENGINE" == "codex" ]] \
  || { print -u2 "dispatch-chain-runner: DISPATCH_ENGINE must be claude or codex"; exit 64; }
CHAIN_MODEL="${DISPATCH_MODEL:-}"
CHAIN_EFFORT="${DISPATCH_EFFORT:-high}"
FALLBACK_MODEL="claude-opus-4-8"
CLAUDE_DEFAULT_MODEL="claude-fable-5"
CODEX_DEFAULT_MODEL="gpt-5.6-sol"

# The verify stage runs on Luna regardless of the build's engine; the two
# overrides exist only for stub chains and tests.
VERIFY_ENGINE="${DISPATCH_VERIFY_ENGINE:-codex}"
[[ "$VERIFY_ENGINE" == "claude" || "$VERIFY_ENGINE" == "codex" ]] \
  || { print -u2 "dispatch-chain-runner: DISPATCH_VERIFY_ENGINE must be claude or codex"; exit 64; }
if [[ "$VERIFY_ENGINE" == "codex" ]]; then
  VERIFY_MODEL="${DISPATCH_VERIFY_MODEL:-gpt-5.6-luna}"
else
  VERIFY_MODEL="${DISPATCH_VERIFY_MODEL:-$CLAUDE_DEFAULT_MODEL}"
fi
VERIFY_EFFORT=high

# Both CLIs resolve up front; a unit whose engine is missing stops the chain
# at that unit with a journal line instead of at launch.
CLAUDE_BIN=$(command -v claude)
CODEX_BIN=$(command -v codex)

# Header value `<!-- key: value -->` from a prompt file's first 4 KB, or empty.
header_value() {
  python3 - "$1" "$2" <<'PYEOF'
import re, sys
head = open(sys.argv[1], encoding='utf-8', errors='replace').read(4096)
m = re.search(r'<!--\s*' + re.escape(sys.argv[2]) + r':\s*(.*?)\s*-->', head, re.I)
print(m.group(1) if m else '')
PYEOF
}

# Per-unit engine, model and effort: header, then env, then engine default.
# Sets UNIT_ENGINE, UNIT_MODEL, UNIT_EFFORT, UNIT_BIN for the prompt file $1.
unit_settings() {
  local engine model effort
  engine=$(header_value "$1" engine | tr '[:upper:]' '[:lower:]')
  UNIT_ENGINE="${engine:-$CHAIN_ENGINE}"
  model=$(header_value "$1" model)
  if [[ -z "$model" && "$UNIT_ENGINE" == "$CHAIN_ENGINE" ]]; then
    model="$CHAIN_MODEL"
  fi
  if [[ -z "$model" ]]; then
    [[ "$UNIT_ENGINE" == "codex" ]] && model="$CODEX_DEFAULT_MODEL" || model="$CLAUDE_DEFAULT_MODEL"
  fi
  UNIT_MODEL="$model"
  effort=$(header_value "$1" effort | tr '[:upper:]' '[:lower:]')
  UNIT_EFFORT="${effort:-$CHAIN_EFFORT}"
  [[ "$UNIT_ENGINE" == "codex" ]] && UNIT_BIN="$CODEX_BIN" || UNIT_BIN="$CLAUDE_BIN"
}

# Session-limit resilience (ui10 phase 1): a limit-exit never trips the commit
# gate. CSWAP_PATH override mirrors server/modules/accounts.
CSWAP_BIN="${CSWAP_PATH:-$HOME/.local/bin/cswap}"
MCP_EMPTY="$HOME/forge-logs/mcp-empty.json"
[ -f "$MCP_EMPTY" ] || printf '{"mcpServers":{}}' > "$MCP_EMPTY"
LIMIT_PATTERN='hit your session limit|session limit reached|usage limit reached|reached your .* limit|out of usage credits|spend limit'
# Codex usage-limit exits (codex job 2): the "hit your usage limit" message
# family. The runner waits for the reset in the unit's own rollout, or
# DISPATCH_CODEX_LIMIT_BACKOFF seconds when no reading exists, then retries;
# a reset further out than 12 hours (a weekly cap) stops the chain instead.
CODEX_LIMIT_PATTERN='usage limit|usage_limit'
CODEX_LIMIT_BACKOFF="${DISPATCH_CODEX_LIMIT_BACKOFF:-1800}"
CODEX_LIMIT_STOP_SECS=$((12 * 3600))
# A monthly spend cap (claude.ai billing) is invisible to cswap's usage
# percentages, so a capped account looks fresh and recovery would bounce
# straight back to it. Spend-cap exits park the account (ui14 job 8).
SPEND_PATTERN='spend limit'
PARK_DIR="$HOME/forge-logs/cswap-parked"
# Long-park escalation: after this many wait cycles with no account headroom,
# one decision-needed fleet notification says the chain is parked.
PARK_ESCALATE_CYCLES="${DISPATCH_PARK_ESCALATE_CYCLES:-3}"

# API key from server config; keep it out of argv (curl reads a header file).
API_KEY=$(/usr/bin/sqlite3 "$DB_PATH" "SELECT api_key FROM api_keys WHERE is_active=1 ORDER BY id LIMIT 1" 2>/dev/null)
[[ -n "$API_KEY" ]] || { print -u2 "dispatch-chain-runner: no active API key in server config"; exit 78; }
HEADER_FILE=$(mktemp)
chmod 600 "$HEADER_FILE"
print -r -- "header = \"x-api-key: $API_KEY\"" > "$HEADER_FILE"
trap 'rm -f "$HEADER_FILE"' EXIT

JOURNAL_DIR="$HOME/forge-logs/$SLUG"
mkdir -p "$JOURNAL_DIR"
JOURNAL="$JOURNAL_DIR/JOURNAL.md"
journal() { print -r -- "$(date +%H:%M) | $1 | $2 | $3" >> "$JOURNAL"; }

TOTAL=${#PHASE_FILES[@]}

# POST an event body to a watchdog path, retrying while the server is down
# (promote restart). $3 is the attempt budget; boundary events use a short
# one and keep going, terminal events retry long because the chain-end wake
# must never be lost.
api_post() {
  # $1 path, $2 json body, $3 attempts
  local attempt=1 max="${3:-3}" delay=5
  while true; do
    if curl -sf -K "$HEADER_FILE" -m 30 -X POST "$SERVER_URL$1" \
        -H 'Content-Type: application/json' -d "$2" >/dev/null 2>&1; then
      return 0
    fi
    if [[ $attempt -ge $max ]]; then
      journal watchdog "unreachable" "gave up on POST $1 after $max attempts"
      return 1
    fi
    sleep $delay
    [[ $delay -lt 30 ]] && delay=$((delay * 2))
    attempt=$((attempt + 1))
  done
}

# Every event carries projectPath and phases so a restarted server can
# re-register the chain it lost with the event itself.
event_body() {
  # $1 event, $2 phase (or empty), $3 summaryTail json string (or empty),
  # $4 commit short hash (or empty), $5 commit subject (or empty)
  python3 - "$1" "$2" "$3" "$REPO" "$TOTAL" "${4:-}" "${5:-}" <<'PYEOF'
import json, sys
event, phase, tail, repo, total, commit_hash, commit_subject = sys.argv[1:8]
body = {'event': event, 'projectPath': repo, 'phases': int(total)}
if phase:
    body['phase'] = int(phase)
if tail:
    body['summaryTail'] = json.loads(tail)
if commit_hash:
    body['commit'] = {'hash': commit_hash, 'subject': commit_subject}
print(json.dumps(body))
PYEOF
}

json_string() { python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }

# Chrome-cap queueing hook: browser-phase chains wait for a Chrome slot
# instead of launching a fourth instance. The wait is bounded (ui14 job 7):
# past chrome-slot-wait's ceiling the chain stops with a journal line and a
# stopped event instead of queueing forever.
wait_for_chrome_slot() {
  local helper="$HOME/.local/bin/chrome-slot-wait"
  [[ -x "$helper" ]] || return 0
  "$helper" && return 0
  journal "phase $PHASE_NUM/$TOTAL" "STOPPED" "chrome-slot-wait hit its ceiling with no free Chrome slot before $PHASE_NAME"
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body stopped $PHASE_NUM "$(print -rn -- "Phase $PHASE_NUM ($PHASE_NAME) never got a Chrome slot: chrome-slot-wait hit its ceiling." | json_string)")" 80
  exit 2
}

# ----- session-limit resilience (ui10 phase 1) ------------------------------
# When claude exits nonzero with the session-limit message in the phase log,
# the runner switches to the next enabled account with 5h headroom via cswap
# (order: current, then remaining slots), mirrors the fresh credential into
# this instance's scoped Keychain, and retries the phase; with no viable
# account it sleeps until the earliest 5h reset and retries then.

# After a cswap switch the *default* Keychain item holds the new account, but
# an instance scoped by CLAUDE_CONFIG_DIR reads its own service. Mirror the
# way server/modules/accounts does: service suffix is sha256(NFC(config
# dir))[:8], credential travels via `security -i` + hex payload, never argv.
mirror_keychain() {
  [[ -n "${CLAUDE_CONFIG_DIR:-}" ]] || return 0
  local digest creds hex
  digest=$(python3 -c 'import hashlib,os,unicodedata;print(hashlib.sha256(unicodedata.normalize("NFC",os.environ["CLAUDE_CONFIG_DIR"]).encode()).hexdigest()[:8])') || return 1
  creds=$(/usr/bin/security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null)
  [[ -n "$creds" ]] || return 1
  hex=$(print -rn -- "$creds" | /usr/bin/xxd -p -u | tr -d '\n')
  print -r -- "add-generic-password -U -a \"$USER\" -s \"Claude Code-credentials-$digest\" -X $hex" \
    | /usr/bin/security -i >/dev/null 2>&1 || return 1
  print -r -- "$creds" > "$CLAUDE_CONFIG_DIR/.credentials.json" \
    && chmod 600 "$CLAUDE_CONFIG_DIR/.credentials.json"
}

# Recovery decision from `cswap list --json`: prints "stay", "switch <num>
# <email>", or "wait <seconds> <until>". Headroom = readable 5h window under
# 90%. An account whose quota reads unreadable is tried after readable ones —
# the 2026-08-23 death taught that unreadable is not exhausted. $1=1 forces
# the wait branch (guard when every account was already tried this phase).
pick_recovery() {
  local listing
  listing=$(env -u CLAUDE_CONFIG_DIR "$CSWAP_BIN" list --json 2>/dev/null)
  FORCE_WAIT="${1:-}" CSWAP_LISTING="$listing" python3 - <<'PYEOF'
import datetime, json, os, sys
try:
    data = json.loads(os.environ.get('CSWAP_LISTING') or '')
except Exception:
    print("wait 1800 unknown-cswap-list-unreadable")
    sys.exit(0)
accounts = [a for a in data.get('accounts', []) if not a.get('disabled')]
current = data.get('activeAccountNumber')
ordered = sorted(accounts, key=lambda a: (a.get('number') != current, a.get('number') or 0))
five = lambda a: ((a.get('usage') or {}).get('fiveHour') or {})
if os.environ.get('FORCE_WAIT') != '1':
    for a in ordered:
        pct = five(a).get('pct')
        if isinstance(pct, (int, float)) and pct < 90:
            print('stay' if a.get('number') == current else f"switch {a.get('number')} {a.get('email', '')}")
            sys.exit(0)
    for a in ordered:
        if a.get('number') != current and not isinstance(five(a).get('pct'), (int, float)):
            print(f"switch {a.get('number')} {a.get('email', '')} (quota unreadable, trying anyway)")
            sys.exit(0)
resets = []
for a in accounts:
    iso = five(a).get('resetsAt')
    if iso:
        try:
            dt = datetime.datetime.fromisoformat(iso.replace('Z', '+00:00'))
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=datetime.timezone.utc)
            resets.append(dt)
        except ValueError:
            pass
if resets:
    earliest = min(resets)
    now = datetime.datetime.now(datetime.timezone.utc)
    secs = max(60, int((earliest - now).total_seconds()) + 60)
    print(f"wait {secs} {earliest.isoformat()}")
else:
    print("wait 1800 unknown-no-reset-times")
PYEOF
}

# Spend-cap parking: `cswap disable` holds the capped account out of every
# automatic pick (pick_recovery skips disabled slots) while keeping its login.
# A marker under PARK_DIR records the billing month, so the next runner start
# re-enables accounts parked in an earlier month.
park_spend_capped() {
  local listing current email
  listing=$(env -u CLAUDE_CONFIG_DIR "$CSWAP_BIN" list --json 2>/dev/null)
  current=$(CSWAP_LISTING="$listing" python3 -c 'import json,os
d=json.loads(os.environ["CSWAP_LISTING"] or "{}"); n=d.get("activeAccountNumber")
print("" if n is None else n)' 2>/dev/null)
  [[ -n "$current" ]] || { journal "$1" "park" "spend limit hit but cswap cannot name the active account; not parked"; return 1; }
  email=$(CSWAP_LISTING="$listing" python3 -c 'import json,os
d=json.loads(os.environ["CSWAP_LISTING"]); print(next((a.get("email","") for a in d.get("accounts",[]) if a.get("number")==d.get("activeAccountNumber")),""))' 2>/dev/null)
  if env -u CLAUDE_CONFIG_DIR "$CSWAP_BIN" disable "$current" >/dev/null 2>&1; then
    mkdir -p "$PARK_DIR"
    print -r -- "$(date +%Y-%m) $email" > "$PARK_DIR/$current"
    journal "$1" "park" "monthly spend limit on account $current ($email); parked via cswap disable until $(date +%Y-%m) ends"
  else
    journal "$1" "park" "cswap disable $current failed; recovery may bounce back to the capped account"
    return 1
  fi
}

# Accounts parked in an earlier billing month return to rotation at runner start.
unpark_stale() {
  local marker month
  for marker in "$PARK_DIR"/*(N.); do
    month=$(cut -d' ' -f1 "$marker")
    [[ "$month" != "$(date +%Y-%m)" ]] || continue
    if env -u CLAUDE_CONFIG_DIR "$CSWAP_BIN" enable "${marker:t}" >/dev/null 2>&1; then
      rm -f "$marker"
      journal run "unpark" "account ${marker:t} parked in $month re-enabled for the new cycle"
    fi
  done
}

LIMIT_STREAK=0
WAIT_CYCLES=0
WAIT_TOTAL=0
PARK_ESCALATED=0

# Account recovery after a limit exit, shared by both stages: $1 is the
# journal label ("phase N/T" or "verify N/T"), $2 the unit number, $3 its
# name, $4 the stage log, $5 the stage (build|verify). Parks a spend-capped
# account, then switches, stays, or sleeps out the reset; the `limit`
# watchdog event keeps the chain running and wakes the planner with
# "auto-recovering", not "FAILED". A verify-stage limit event carries no
# phase, so it never moves the chain's current job. Exits the chain only when
# cswap is missing. The caller re-runs the stage afterwards.
recover_from_limit() {
  local label="$1" unit="$2" name="$3" log="$4" stage="${5:-build}"
  local event_phase="$unit" what="Phase $unit ($name)"
  if [[ "$stage" == verify ]]; then
    event_phase=""
    what="The verify of job $unit ($name)"
  fi
  LIMIT_STREAK=$((LIMIT_STREAK + 1))
  journal "$label" "limit" "claude exited on the session limit (attempt $LIMIT_STREAK); auto-recovering"
  if [[ ! -x "$CSWAP_BIN" ]]; then
    journal "$label" "FAILED" "limit hit but cswap missing at $CSWAP_BIN; cannot auto-recover"
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body failed $unit "$(print -rn -- "Phase $unit ($name) hit the session limit and auto-recovery is unavailable (cswap missing at $CSWAP_BIN)." | json_string)")" 80
    exit 1
  fi
  if grep -qiE "$SPEND_PATTERN" "$log"; then
    park_spend_capped "$label"
  fi
  local force_wait=""
  [[ $LIMIT_STREAK -gt 3 ]] && force_wait=1
  RECOVERY=$(pick_recovery "$force_wait")
  case "${RECOVERY%% *}" in
    switch)
      local target
      target=$(print -r -- "$RECOVERY" | awk '{print $2}')
      if env -u CLAUDE_CONFIG_DIR "$CSWAP_BIN" switch "$target" --json >/dev/null 2>&1; then
        journal "$label" "switch" "switched account: ${RECOVERY#switch }"
      else
        journal "$label" "switch" "cswap switch $target failed; retrying on current account"
      fi
      mirror_keychain \
        && journal "$label" "mirror" "scoped Keychain + .credentials.json refreshed for ${CLAUDE_CONFIG_DIR:-default profile (no-op)}" \
        || journal "$label" "mirror" "keychain mirror failed; scoped instances may lag one account behind"
      ;;
    stay)
      journal "$label" "switch" "current account already has 5h headroom; retrying without a switch"
      ;;
    wait)
      WAIT_SECS=$(print -r -- "$RECOVERY" | awk '{print $2}')
      WAIT_UNTIL=$(print -r -- "$RECOVERY" | awk '{print $3}')
      WAIT_CYCLES=$((WAIT_CYCLES + 1))
      WAIT_TOTAL=$((WAIT_TOTAL + WAIT_SECS))
      journal "$label" "wait" "no account with 5h headroom; sleeping ${WAIT_SECS}s until $WAIT_UNTIL (wait cycle $WAIT_CYCLES)"
      if [[ $WAIT_CYCLES -ge $PARK_ESCALATE_CYCLES && $PARK_ESCALATED -eq 0 ]]; then
        PARK_ESCALATED=1
        journal "$label" "parked" "chain parked $WAIT_CYCLES wait cycles (${WAIT_TOTAL}s) with no account headroom; decision-needed sent"
        api_post "/api/watchdog/notify" "$(python3 - "$SLUG" "$unit" "$TOTAL" "$name" "$WAIT_CYCLES" "$WAIT_TOTAL" "$WAIT_UNTIL" <<'PYEOF'
import json, sys
slug, phase, total, name, cycles, waited, until = sys.argv[1:8]
hours = round(int(waited) / 3600, 1)
print(json.dumps({
    'kind': 'decision-needed',
    'title': f'Chain {slug} parked waiting for an account reset',
    'body': f'Job {phase} of {total} ({name}) has waited {cycles} cycles (about {hours} h) with no account under 90% of its 5h window; next retry after {until}. Raise a cap, enable an account, or stop the chain.',
}))
PYEOF
)" 3
      fi
      ;;
  esac
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body limit "$event_phase" "$(print -rn -- "$what hit the session limit; recovery: $RECOVERY." | json_string)")" 3
  if [[ "${RECOVERY%% *}" == "wait" ]]; then
    sleep "$WAIT_SECS"
    LIMIT_STREAK=0
  fi
}

# One headless claude session: $1 prompt file, $2 log, $3 session id, $4
# model, $5 effort. exec'd so a caller running it in the background holds
# claude's own pid (killable on a rewind). The two CLAUDE_CODE_ lines are
# load-bearing (runner doctrine): the first forces subagents synchronous so a
# turn cannot end while work runs, the second makes anything that slips
# through be waited on uncapped. Empty ANTHROPIC_API_KEY pins subscription
# auth. Fable phases carry the Opus 4.8 capacity fallback; a unit pinned to
# 4.8 carries none.
run_claude() {
  typeset -a fallback_args
  fallback_args=()
  [[ "$4" != "$FALLBACK_MODEL" ]] && fallback_args=(--fallback-model "$FALLBACK_MODEL")
  # setsid puts the session in its own process group (pid == pgid, since the
  # exec keeps the pid) so a rewind can kill claude and everything it spawned.
  ANTHROPIC_API_KEY="" \
  CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1 \
  CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
    exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
    "$CLAUDE_BIN" -p --strict-mcp-config --mcp-config "$MCP_EMPTY" --model "$4" --effort "$5" "${fallback_args[@]}" \
    --session-id "$3" \
    --dangerously-skip-permissions \
    < "$1" > "$2" 2>&1
}

# One headless Codex session with the same prompt/log/model/effort contract
# as run_claude ($3 is unused: Codex assigns its own thread id, which the
# runner reads back off the `--json` event stream in the log and announces).
# The prompt arrives on stdin; the final message lands in $2.last for the
# verifier's exact VERIFY line. Subagents stay off by explicit override so a
# config edit cannot turn them back on for dispatched units (codex job 2).
run_codex() {
  exec python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
    "$CODEX_BIN" exec \
    --dangerously-bypass-approvals-and-sandbox \
    --json \
    -C "$REPO" \
    -m "$4" \
    -c model_reasoning_effort="$5" \
    -c features.multi_agent=false \
    -o "$2.last" \
    - \
    < "$1" > "$2" 2>&1
}

# $1 engine, then the run_claude contract: prompt, log, session id, model, effort.
run_engine() {
  local engine="$1"; shift
  if [[ "$engine" == "codex" ]]; then
    run_codex "$@"
  else
    run_claude "$@"
  fi
}

# Pre-tag a stage session: the id is announced to the server so the row
# exists tagged origin=dispatch (with the chain slug, unit, engine and model)
# before transcript discovery can index it untagged — before claude starts
# for Claude units, and the moment Codex reports its thread id for Codex
# units (the same id the rollout synchronizer indexes, so both are one row).
# $1 session id, $2 base commit, $3 unit, $4 stage (build|verify), $5
# provider, $6 model.
announce_session() {
  api_post "/api/watchdog/chains/$SLUG/sessions" "$(python3 - "$1" "$REPO" "$2" "$6" "$3" "$4" "$5" <<'PYEOF'
import json, sys
sid, repo, base, model, phase, stage, provider = sys.argv[1:8]
print(json.dumps({'sessionId': sid, 'projectPath': repo, 'baseCommit': base, 'model': model, 'phase': int(phase), 'stage': stage, 'provider': provider}))
PYEOF
)" 3
}

# Codex thread id off a `codex exec --json` log: waits up to 90 s for the
# thread.started event while the process ($2) lives. Prints the id or nothing.
wait_thread_id() {
  local i=0 id=""
  while [[ $i -lt 90 ]]; do
    id=$(grep -o '"thread_id":"[^"]*"' "$1" 2>/dev/null | head -1 | cut -d'"' -f4)
    [[ -n "$id" ]] && break
    kill -0 "$2" 2>/dev/null || break
    sleep 1
    i=$((i + 1))
  done
  print -r -- "$id"
}

# ----- Codex usage-limit wait (codex job 2) --------------------------------
# Decision from the rate_limits block of the unit's own rollout (by thread
# id), else the newest rollout: prints "wait <secs> <until>" or "stop <until>
# <window-minutes>" (a reset past the 12 h ceiling: the weekly cap), or the
# fixed backoff when nothing is readable.
codex_limit_decision() {
  CODEX_THREAD="${1:-}" BACKOFF="$CODEX_LIMIT_BACKOFF" STOP_SECS="$CODEX_LIMIT_STOP_SECS" python3 - <<'PYEOF'
import datetime, glob, json, os, sys
home = os.path.expanduser('~/.codex/sessions')
thread = os.environ.get('CODEX_THREAD') or ''
files = glob.glob(os.path.join(home, '**', f'rollout-*{thread}.jsonl'), recursive=True) if thread else []
if not files:
    files = glob.glob(os.path.join(home, '**', 'rollout-*.jsonl'), recursive=True)
files.sort(key=lambda p: os.path.getmtime(p), reverse=True)
limits = None
for path in files[:1]:
    try:
        lines = open(path, encoding='utf-8', errors='replace').read().splitlines()
    except OSError:
        continue
    for line in reversed(lines):
        if '"rate_limits"' not in line:
            continue
        try:
            payload = json.loads(line).get('payload') or {}
        except ValueError:
            continue
        if payload.get('type') == 'token_count' and isinstance(payload.get('rate_limits'), dict):
            limits = payload['rate_limits']
            break
if not limits:
    print(f"wait {os.environ['BACKOFF']} unknown-no-rate-limits-readable")
    sys.exit(0)
# The exhausted window is the one the reading names, else any at 100%; a
# reading that shows headroom everywhere does not explain the exit, so the
# fixed backoff applies rather than a guess at a reset.
named = str(limits.get('rate_limit_reached_type') or '').lower()
windows = []
for key in ('primary', 'secondary'):
    w = limits.get(key)
    if not (isinstance(w, dict) and w.get('resets_at')):
        continue
    if key in named or (w.get('used_percent') or 0) >= 99:
        windows.append(w)
if not windows:
    print(f"wait {os.environ['BACKOFF']} unknown-no-exhausted-window")
    sys.exit(0)
hit = min(windows, key=lambda w: int(w['resets_at']))
reset = datetime.datetime.fromtimestamp(int(hit['resets_at']), datetime.timezone.utc)
now = datetime.datetime.now(datetime.timezone.utc)
secs = int((reset - now).total_seconds()) + 60
if secs > int(os.environ['STOP_SECS']):
    print(f"stop {reset.isoformat()} {hit.get('window_minutes') or '?'}")
else:
    print(f"wait {max(60, secs)} {reset.isoformat()}")
PYEOF
}

# A Codex unit exited on its usage limit: journal, a recovery notification
# (never a planner wake), then wait for the reset and let the caller re-run
# the stage on the uncommitted tree. Models and accounts are never switched.
# A weekly cap with no reset inside 12 hours stops the chain with a
# decision-needed notification naming Terra as the manual fallback.
# $1 journal label, $2 unit, $3 name, $4 stage (build|verify), $5 thread id.
wait_codex_limit() {
  local label="$1" unit="$2" name="$3" stage="${4:-build}" thread="${5:-}"
  local decision kind secs until what event_phase="$unit"
  what="Job $unit ($name)"
  [[ "$stage" == verify ]] && { what="The verify of job $unit ($name)"; event_phase=""; }
  decision=$(codex_limit_decision "$thread")
  kind="${decision%% *}"
  secs=$(print -r -- "$decision" | awk '{print $2}')
  until=$(print -r -- "$decision" | awk '{print $3}')
  if [[ "$kind" == stop ]]; then
    journal "$label" "STOPPED" "codex usage limit with no reset inside 12 h (window ${until}m resets $secs); weekly cap, Terra is the manual fallback"
    api_post "/api/watchdog/notify" "$(python3 - "$SLUG" "$unit" "$TOTAL" "$name" "$secs" <<'PYEOF'
import json, sys
slug, phase, total, name, until = sys.argv[1:6]
print(json.dumps({
    'kind': 'decision-needed',
    'title': f'Chain {slug} stopped on the Codex weekly cap',
    'body': f'Job {phase} of {total} ({name}) hit a Codex usage limit that does not reset until {until}. Re-dispatch on gpt-5.6-terra by hand, or wait for the reset.',
}))
PYEOF
)" 3
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body stopped "$unit" "$(print -rn -- "$what hit the Codex weekly usage cap (resets $secs); stopped, Terra is the manual fallback." | json_string)")" 80
    exit 2
  fi
  journal "$label" "limit" "codex exited on its usage limit; waiting ${secs}s until $until, then retrying"
  api_post "/api/watchdog/notify" "$(python3 - "$SLUG" "$unit" "$TOTAL" "$name" "$secs" "$until" <<'PYEOF'
import json, sys
slug, phase, total, name, secs, until = sys.argv[1:7]
print(json.dumps({
    'kind': 'recovery',
    'title': f'Chain {slug} waiting on a Codex usage limit',
    'body': f'Job {phase} of {total} ({name}) hit the Codex usage limit; retrying after {until} (about {round(int(secs) / 60)} min). No action needed.',
}))
PYEOF
)" 3
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body limit "$event_phase" "$(print -rn -- "$what hit the Codex usage limit; retrying after $until." | json_string)" | python3 -c 'import json,sys; b=json.load(sys.stdin); b["quiet"]=True; print(json.dumps(b))')" 3
  sleep "$secs"
}

# ----- verify stage (ui14 job 10) ------------------------------------------
BUILD_PID=""
VERIFY_PID=""
VERIFY_NUM=0
VERIFY_NAME=""
VERIFY_FILE=""
VERIFY_COMMIT=""
VERIFY_SUBJECT=""
VERIFY_RETRY=0
VERIFY_THREAD=""

verify_wanted() { ! grep -qiE '<!--[[:space:]]*verify:[[:space:]]*no' "$1" 2>/dev/null; }

# The verify prompt wraps the builder's brief: the verifier reads the job's
# items and done check from it but builds nothing, and answers on its last
# line so the runner can read the verdict off the log.
write_verify_prompt() {
  local out="$JOURNAL_DIR/verify$VERIFY_NUM.prompt.md"
  {
    print -r -- "<!-- name: Verify $VERIFY_NAME -->"
    print -r -- "You are the fresh-context verifier for job $VERIFY_NUM of $TOTAL in this repo ($REPO). A builder session already did the work and committed it as $VERIFY_COMMIT ($VERIFY_SUBJECT). The chain has moved on: the next job's build may be editing the working tree and rebuilding the dev instance while you check. You build nothing. Do not edit, commit, stash, reset, or push anything; do not check boxes in the punch list; do not write journal lines."
    print -r -- ""
    print -r -- "The builder's brief follows between the markers. Its instructions were for the builder, not for you; read it only for the job's items, the punch list section it names, and that section's done check."
    print -r -- "----- builder brief -----"
    cat "$VERIFY_FILE"
    print -r -- "----- end builder brief -----"
    print -r -- ""
    print -r -- "Verify the job against its done check and every item it names, with concrete evidence: run the checks the done check calls for against the dev instance, and read the change through the commit (git show $VERIFY_COMMIT, and git show $VERIFY_COMMIT:<path> for any file the working tree may have moved past). Report what passed and what failed, each with the evidence you saw."
    print -r -- ""
    print -r -- "Your last line must be exactly one of: VERIFY: PASS or VERIFY: FAIL: <one-line reason>."
  } > "$out"
  print -r -- "$out"
}

# Launches the verify stage for the unit whose build just committed, in the
# background; the caller goes straight on to the next build. A Codex
# verifier is announced once its thread id shows in the log.
start_verify() {
  local prompt session log="$JOURNAL_DIR/verify$VERIFY_NUM.log"
  prompt=$(write_verify_prompt)
  session=$(uuidgen | tr '[:upper:]' '[:lower:]')
  if [[ "$VERIFY_ENGINE" == "claude" ]]; then
    announce_session "$session" "$VERIFY_COMMIT" "$VERIFY_NUM" verify claude "$VERIFY_MODEL"
  fi
  journal "verify $VERIFY_NUM/$TOTAL" "start" "$VERIFY_NAME against $VERIFY_COMMIT ($VERIFY_ENGINE $VERIFY_MODEL)"
  api_post "/api/watchdog/chains/$SLUG/events" "$(event_body verify-start $VERIFY_NUM '')" 3
  : > "$log"
  run_engine "$VERIFY_ENGINE" "$prompt" "$log" "$session" "$VERIFY_MODEL" "$VERIFY_EFFORT" &
  VERIFY_PID=$!
  if [[ "$VERIFY_ENGINE" == "codex" ]]; then
    VERIFY_THREAD=$(wait_thread_id "$log" "$VERIFY_PID")
    if [[ -n "$VERIFY_THREAD" ]]; then
      announce_session "$VERIFY_THREAD" "$VERIFY_COMMIT" "$VERIFY_NUM" verify codex "$VERIFY_MODEL"
    else
      journal "verify $VERIFY_NUM/$TOTAL" "announce" "codex reported no thread id; the verifier's rollout stays unlinked"
    fi
  fi
}

# Reads a finished verifier's verdict off its log. PASS clears the stage; a
# limit exit without a verdict marks the stage for a re-run once no build is
# in flight (reconcile_verify); anything else is a FAIL and rewinds.
settle_verify() {
  local rc log="$JOURNAL_DIR/verify$VERIFY_NUM.log" verdict verdict_source
  wait $VERIFY_PID
  rc=$?
  VERIFY_PID=""
  # Codex writes its final assistant message to .last; Claude's verdict stays
  # in the session log. The verdict is the last VERIFY: line, wherever markdown wrapped it
  # (`**VERIFY: PASS**`, a backticked or indented line all count).
  verdict_source="$log"
  [[ "$VERIFY_ENGINE" == "codex" ]] && verdict_source="$log.last"
  verdict=$(grep -oE 'VERIFY: (PASS|FAIL[^`*]*)' "$verdict_source" 2>/dev/null | tail -1 | sed 's/[[:space:]]*$//')
  if [[ "$VERIFY_ENGINE" == "claude" && $rc -ne 0 && -z "$verdict" ]] && grep -qiE "$LIMIT_PATTERN" "$log"; then
    journal "verify $VERIFY_NUM/$TOTAL" "limit" "verifier exited $rc on the session limit; re-running once the build in flight has recovered"
    VERIFY_RETRY=1
    return 0
  fi
  if [[ "$VERIFY_ENGINE" == "codex" && $rc -ne 0 && -z "$verdict" ]] && grep -qiE "$CODEX_LIMIT_PATTERN" "$log"; then
    journal "verify $VERIFY_NUM/$TOTAL" "limit" "verifier exited $rc on the codex usage limit; re-running once the build in flight has finished"
    VERIFY_RETRY=1
    return 0
  fi
  if [[ "$verdict" == "VERIFY: PASS"* ]]; then
    journal "verify $VERIFY_NUM/$TOTAL" "end" "PASS for $VERIFY_COMMIT"
    api_post "/api/watchdog/chains/$SLUG/events" "$(event_body verify-end $VERIFY_NUM '')" 3
    VERIFY_NUM=0
    return 0
  fi
  rewind_after_verify_failure "${verdict:-VERIFY: FAIL: verifier exited $rc without a verdict (verify$VERIFY_NUM.log)}"
}

# A failed verify stops the chain and rewinds: the in-flight build (unit
# N+1) is killed, whatever it produced is parked as a WIP commit on a branch
# (main is never rewritten: the failing commit and anything after it may
# already be pushed), and the verify-failed event carries the resume point.
rewind_after_verify_failure() {
  local reason="$1" state head main_branch next_file branch
  local next=$((VERIFY_NUM + 1))
  branch="dispatch/$SLUG/job$next-parked"
  journal "verify $VERIFY_NUM/$TOTAL" "FAILED" "$reason"
  if [[ -n "$BUILD_PID" ]] && kill -0 $BUILD_PID 2>/dev/null; then
    # The build is its own process group (run_claude): the whole tree goes.
    kill -TERM -- -$BUILD_PID 2>/dev/null || kill -TERM $BUILD_PID 2>/dev/null
    local i=0
    while kill -0 $BUILD_PID 2>/dev/null && [[ $i -lt 30 ]]; do sleep 1; i=$((i + 1)); done
    kill -0 $BUILD_PID 2>/dev/null && { kill -KILL -- -$BUILD_PID 2>/dev/null || kill -KILL $BUILD_PID 2>/dev/null; }
    wait $BUILD_PID 2>/dev/null
    journal "phase $next/$TOTAL" "killed" "build of $PHASE_NAME stopped mid-run: job $VERIFY_NUM failed verify"
  fi
  BUILD_PID=""
  head=$(git -C "$REPO" rev-parse --short HEAD)
  main_branch=$(git -C "$REPO" rev-parse --abbrev-ref HEAD)
  local resume_unit=$next
  if [[ -n "$(git -C "$REPO" status --porcelain)" ]]; then
    if git -C "$REPO" checkout -q -b "$branch" \
      && git -C "$REPO" add -A \
      && git -C "$REPO" commit -q --no-verify -m "wip(dispatch): job $next parked after job $VERIFY_NUM failed verify"; then
      state="job $next's uncommitted work is parked as a WIP commit on branch $branch; $main_branch is untouched at $head"
    else
      state="job $next's uncommitted work could not be parked (git refused the branch or commit); the tree is left as it stands"
    fi
    git -C "$REPO" checkout -q "$main_branch" 2>/dev/null
  elif [[ "$head" != "$VERIFY_COMMIT" ]]; then
    git -C "$REPO" branch -f "$branch" HEAD
    state="job $next already committed on $main_branch after the failing commit ($head, built on the unverified job $VERIFY_NUM; review it against the fix); branch $branch marks it"
    resume_unit=$((next + 1))
  else
    state="job $next left no work; $main_branch is at $VERIFY_COMMIT"
  fi
  journal "run" "rewind" "$state"
  next_file="${PHASE_FILES[$resume_unit]:-}"
  if [[ -n "$next_file" ]]; then
    next_file="then re-dispatch from unit $resume_unit ($next_file)"
  else
    next_file="no unit is left to re-dispatch after job $((resume_unit - 1))"
  fi
  RESUME="Job $VERIFY_NUM ($VERIFY_NAME) failed verify at commit $VERIFY_COMMIT: ${reason#VERIFY: FAIL: }. $state. Resume point: fix job $VERIFY_NUM from $VERIFY_COMMIT (verify log $JOURNAL_DIR/verify$VERIFY_NUM.log), $next_file."
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body verify-failed $VERIFY_NUM "$(print -rn -- "$RESUME" | json_string)")" 80
  exit 3
}

# Blocks until the in-flight verify (if any) has settled, re-running it after
# a limit exit now that no build is in flight; a FAIL rewinds and exits.
reconcile_verify() {
  while true; do
    if [[ -n "$VERIFY_PID" ]]; then
      settle_verify
    fi
    if [[ $VERIFY_RETRY -eq 1 ]]; then
      VERIFY_RETRY=0
      if [[ "$VERIFY_ENGINE" == "codex" ]]; then
        wait_codex_limit "verify $VERIFY_NUM/$TOTAL" "$VERIFY_NUM" "$VERIFY_NAME" verify "${VERIFY_THREAD:-}"
      else
        recover_from_limit "verify $VERIFY_NUM/$TOTAL" "$VERIFY_NUM" "$VERIFY_NAME" "$JOURNAL_DIR/verify$VERIFY_NUM.log" verify
      fi
      journal "verify $VERIFY_NUM/$TOTAL" "retry" "re-running the verify of $VERIFY_NAME after limit recovery"
      start_verify
      continue
    fi
    break
  done
}

# Waits for the build in flight, settling the verify the moment it exits so
# a FAIL kills the build within seconds instead of after it finishes.
watch_build() {
  while kill -0 $BUILD_PID 2>/dev/null; do
    if [[ -n "$VERIFY_PID" ]] && ! kill -0 $VERIFY_PID 2>/dev/null; then
      settle_verify
    fi
    sleep 5
  done
  wait $BUILD_PID
}

CHAIN_BASE=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo none)

# The planner-supplied phase manifest (ui9 B4) rides along in the chain
# registration; the watchdog stores it and the phase navigator renders it.
MANIFEST_PATH="${DISPATCH_MANIFEST:-}"

journal run "start" "chain $SLUG in $REPO ($TOTAL phases; default engine $CHAIN_ENGINE, verify on $VERIFY_ENGINE $VERIFY_MODEL)"
[[ -x "$CSWAP_BIN" ]] && unpark_stale
api_post "/api/watchdog/chains" "$(python3 - "$SLUG" "$REPO" "$TOTAL" "$MANIFEST_PATH" <<'PYEOF'
import json, sys
slug, repo, total, manifest_path = sys.argv[1:5]
body = {'slug': slug, 'projectPath': repo, 'phases': int(total)}
if manifest_path:
    try:
        body['manifest'] = json.load(open(manifest_path))
    except Exception:
        pass
print(json.dumps(body))
PYEOF
)" 3

# Append queue (ui9 B4): `dispatch append` drops prompt files here; they are
# picked up after each phase's commit gate and run as additional units.
APPEND_DIR="$JOURNAL_DIR/append"
CONSUMED_DIR="$APPEND_DIR/consumed"
pickup_appends() {
  local f
  for f in "$APPEND_DIR"/*.md(N); do
    mkdir -p "$CONSUMED_DIR"
    mv "$f" "$CONSUMED_DIR/${f:t}"
    PHASE_FILES+=("$CONSUMED_DIR/${f:t}")
    journal append "queued" "${f:t} picked up as unit ${#PHASE_FILES[@]}"
  done
  TOTAL=${#PHASE_FILES[@]}
}

PHASE_NUM=0
while [[ $PHASE_NUM -lt ${#PHASE_FILES[@]} ]]; do
  PHASE_NUM=$((PHASE_NUM + 1))
  PHASE_FILE="${PHASE_FILES[$PHASE_NUM]}"
  PHASE_NAME=$(basename "$PHASE_FILE")
  BASE_COMMIT=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo none)

  if grep -q '<!-- browser -->' "$PHASE_FILE" 2>/dev/null; then
    wait_for_chrome_slot
  fi

  unit_settings "$PHASE_FILE"
  if [[ -z "$UNIT_BIN" ]]; then
    reconcile_verify
    journal "phase $PHASE_NUM/$TOTAL" "FAILED" "$PHASE_NAME needs the $UNIT_ENGINE CLI, which is not on PATH; stopping chain"
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body failed $PHASE_NUM "$(print -rn -- "Phase $PHASE_NUM ($PHASE_NAME) needs the $UNIT_ENGINE CLI, which is not on PATH." | json_string)")" 80
    exit 1
  fi
  journal "phase $PHASE_NUM/$TOTAL" "start" "$PHASE_NAME ($UNIT_ENGINE $UNIT_MODEL, effort $UNIT_EFFORT)"
  api_post "/api/watchdog/chains/$SLUG/events" "$(event_body phase-start $PHASE_NUM '')" 3

  SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
  if [[ "$UNIT_ENGINE" == "claude" ]]; then
    announce_session "$SESSION_ID" "$BASE_COMMIT" "$PHASE_NUM" build claude "$UNIT_MODEL"
  fi

  # The build stage: a fresh headless session in the repo, run in the
  # background so the previous unit's verify can be settled while it works.
  : > "$JOURNAL_DIR/phase$PHASE_NUM.log"
  run_engine "$UNIT_ENGINE" "$PHASE_FILE" "$JOURNAL_DIR/phase$PHASE_NUM.log" "$SESSION_ID" "$UNIT_MODEL" "$UNIT_EFFORT" &
  BUILD_PID=$!
  BUILD_THREAD=""
  if [[ "$UNIT_ENGINE" == "codex" ]]; then
    BUILD_THREAD=$(wait_thread_id "$JOURNAL_DIR/phase$PHASE_NUM.log" "$BUILD_PID")
    if [[ -n "$BUILD_THREAD" ]]; then
      announce_session "$BUILD_THREAD" "$BASE_COMMIT" "$PHASE_NUM" build codex "$UNIT_MODEL"
    else
      journal "phase $PHASE_NUM/$TOTAL" "announce" "codex reported no thread id; the unit's rollout stays unlinked"
    fi
  fi
  watch_build
  RC=$?
  BUILD_PID=""

  NEW_COMMIT=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo none)

  # Limit-exit: recover (switch or wait) and retry the phase instead of
  # tripping the commit gate.
  if [[ "$UNIT_ENGINE" == "claude" && $RC -ne 0 ]] && grep -qiE "$LIMIT_PATTERN" "$JOURNAL_DIR/phase$PHASE_NUM.log"; then
    recover_from_limit "phase $PHASE_NUM/$TOTAL" "$PHASE_NUM" "$PHASE_NAME" "$JOURNAL_DIR/phase$PHASE_NUM.log"
    journal "phase $PHASE_NUM/$TOTAL" "retry" "re-running $PHASE_NAME after limit recovery"
    PHASE_NUM=$((PHASE_NUM - 1))
    continue
  fi
  # A Codex usage limit is a wait, never a defect: the unit re-runs on the
  # uncommitted tree after the reset (codex job 2).
  if [[ "$UNIT_ENGINE" == "codex" && $RC -ne 0 ]] && grep -qiE "$CODEX_LIMIT_PATTERN" "$JOURNAL_DIR/phase$PHASE_NUM.log"; then
    wait_codex_limit "phase $PHASE_NUM/$TOTAL" "$PHASE_NUM" "$PHASE_NAME" build "$BUILD_THREAD"
    journal "phase $PHASE_NUM/$TOTAL" "retry" "re-running $PHASE_NAME after the codex limit wait"
    PHASE_NUM=$((PHASE_NUM - 1))
    continue
  fi
  LIMIT_STREAK=0
  WAIT_CYCLES=0
  WAIT_TOTAL=0
  PARK_ESCALATED=0

  if [[ $RC -ne 0 ]]; then
    reconcile_verify
    journal "phase $PHASE_NUM/$TOTAL" "FAILED" "$UNIT_ENGINE exited $RC; stopping chain (phase$PHASE_NUM.log)"
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body failed $PHASE_NUM "$(print -rn -- "Phase $PHASE_NUM ($PHASE_NAME) failed: $UNIT_ENGINE exited $RC." | json_string)")" 80
    exit 1
  fi

  # Commit gate: a phase that lands no commit stops the chain right here.
  if [[ "$NEW_COMMIT" == "$BASE_COMMIT" ]]; then
    reconcile_verify
    if [[ "$UNIT_ENGINE" == "codex" ]]; then
      LOG_TAIL=$(head -c 300 "$JOURNAL_DIR/phase$PHASE_NUM.log.last" 2>/dev/null | tr '\n' ' ')
      journal "phase $PHASE_NUM/$TOTAL" "STOPPED" "commit gate: no new commit after $PHASE_NAME; last message: ${LOG_TAIL:-none}"
    else
      journal "phase $PHASE_NUM/$TOTAL" "STOPPED" "commit gate: no new commit after $PHASE_NAME"
    fi
    api_post "/api/watchdog/chains/$SLUG/events" \
      "$(event_body stopped $PHASE_NUM "$(print -rn -- "Commit gate stopped the chain: phase $PHASE_NUM ($PHASE_NAME) produced no commit." | json_string)")" 80
    exit 2
  fi

  journal "phase $PHASE_NUM/$TOTAL" "end" "$(git -C "$REPO" log -1 --format=%h\ %s)"
  # The phase-end event carries the job's commit (ui13 job 14) so the jobs
  # view can show what each job shipped.
  api_post "/api/watchdog/chains/$SLUG/events" \
    "$(event_body phase-end $PHASE_NUM '' "$(git -C "$REPO" log -1 --format=%h)" "$(git -C "$REPO" log -1 --format=%s)")" 3

  # The previous unit's verify must have passed before this unit's starts:
  # at most one verify is in flight, one build behind it.
  reconcile_verify
  if verify_wanted "$PHASE_FILE"; then
    VERIFY_NUM=$PHASE_NUM
    VERIFY_NAME="$PHASE_NAME"
    VERIFY_FILE="$PHASE_FILE"
    VERIFY_COMMIT=$(git -C "$REPO" log -1 --format=%h)
    VERIFY_SUBJECT=$(git -C "$REPO" log -1 --format=%s)
    start_verify
  fi
  pickup_appends
done

reconcile_verify
TAIL=$(git -C "$REPO" log --oneline "$CHAIN_BASE"..HEAD 2>/dev/null | head -20 | json_string)
journal run "end" "all $TOTAL phases committed and verified"
api_post "/api/watchdog/chains/$SLUG/events" "$(event_body completed $TOTAL "$TAIL")" 80
print -r -- "dispatch: chain $SLUG completed ($TOTAL phases)"
