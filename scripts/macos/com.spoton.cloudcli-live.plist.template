<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LAUNCHD_PREFIX__-live</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__REPO__/scripts/macos/__LEGACY_STEM__-dev-start.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/forge-logs/__SERVICE_LOG_DIR__/live.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/forge-logs/__SERVICE_LOG_DIR__/live.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOST</key>
        <string>0.0.0.0</string>
        <key>SERVER_PORT</key>
        <string>4747</string>
        <key>COMMAND_CENTER_INSTANCE</key>
        <string>live</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin:__HOME__/.npm-global/bin:__HOME__/Library/pnpm</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
