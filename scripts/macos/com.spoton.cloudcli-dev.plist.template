<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spoton.cloudcli-dev</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__REPO__/scripts/macos/cloudcli-dev-start.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- On-demand: started with `launchctl kickstart`, never at boot. -->
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/forge-logs/cloudcli-service/dev.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/forge-logs/cloudcli-service/dev.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOST</key>
        <string>127.0.0.1</string>
        <key>SERVER_PORT</key>
        <string>4748</string>
        <key>CLOUDCLI_INSTANCE</key>
        <string>dev</string>
        <key>DATABASE_PATH</key>
        <string>__HOME__/.cloudcli-dev/auth.db</string>
        <key>CLAUDE_CONFIG_DIR</key>
        <string>__HOME__/.claude-dev</string>
        <key>CLOUDCLI_REPO</key>
        <string>__REPO__</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.local/bin:__HOME__/.npm-global/bin:__HOME__/Library/pnpm</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
